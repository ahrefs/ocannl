  (env_var OCANNL_LOG_LEVEL_TNODE)
  (env_var OCANNL_LOG_LEVEL_LOW_LEVEL)
  (env_var OCANNL_LOG_LEVEL_ASSIGNMENTS)
  (env_var OCANNL_LOG_LEVEL_TASK)
  (env_var OCANNL_LOG_LEVEL_BACKEND_IMPL)
  (env_var OCANNL_LOG_LEVEL_C_SYNTAX))
 (libraries
  base
  printbox
  printbox-text
  pprint
  stdio
  sexplib
  str
  unix
  ctypes
  ctypes.foreign
  mtime
  mtime.clock.os
  utils
  ppx_minidebug.runtime
  ppx_minidebug.db)
 (foreign_stubs
  (language c)
  (names builtins))
 (preprocess
  (pps
   ppx_compare
   ppx_enumerate
   ppx_hash
   ppx_here
   ppx_sexp_conv
   ppx_string
   ppx_variants_conv
   ppx_minidebug))
 (modules
  ops
  interval
