; Each library below declares, as preprocessor dependencies, the per-module tracing gates
; ppx_minidebug reads while PREPROCESSING its modules: one `OCANNL_LOG_LEVEL_<MODULE>` per
; `[%%global_debug_log_level_from_env_var]` at the top of a source file. Declaring them is what
; makes changing one re-preprocess the modules that read it. Until gh-ocannl-628 what was declared
; instead was the runtime `OCANNL_LOG_LEVEL`, which no ppx reads: `OCANNL_LOG_LEVEL_ROW=9 dune
; build` then returned the already-built stripped modules, and the documented recipe had to
; `touch` the sources to force re-preprocessing.

(library
 (name utils)
 (public_name arrayjit.utils)
 (preprocessor_deps
  (env_var OCANNL_LOG_LEVEL_UTILS))
 (modules utils datatypes cpu_topology atomic_file)
 ; `unix` for `Unix.environment`, which the unknown-environment-variable warning walks, and for
 ; `Atomic_file`'s pid, file mtime and sub-second sleep. `mtime.clock.os` for the one thing `unix`
 ; has no clock for: `Atomic_file`'s commit retry is bounded by a DURATION, and a wall clock that
 ; an NTP step moves would either cut that bound short or extend it by the size of the adjustment.
 (libraries
  base
  stdio
  unix
  mtime
  mtime.clock.os
  pprint
  ppx_minidebug.runtime
  ppx_minidebug.db)
 (foreign_stubs
  (language c)
  (names utils_stubs))
 (preprocess
  (pps
   ppx_compare
   ppx_hash
   ppx_here
   ppx_sexp_conv
   ppx_string
   ppx_variants_conv
   ppx_minidebug)))

(library
 (name ir)
 (public_name arrayjit.ir)
 (preprocessor_deps
  (env_var OCANNL_LOG_LEVEL_NDARRAY)
  (env_var OCANNL_LOG_LEVEL_INDEXING)
  (env_var OCANNL_LOG_LEVEL_TNODE)
  (env_var OCANNL_LOG_LEVEL_LOW_LEVEL)
  (env_var OCANNL_LOG_LEVEL_ASSIGNMENTS)
  (env_var OCANNL_LOG_LEVEL_TASK)
  (env_var OCANNL_LOG_LEVEL_BACKEND_IMPL)
  (env_var OCANNL_LOG_LEVEL_C_SYNTAX))
 (libraries
  base
  printbox
  printbox-text
  pprint
  stdio
  sexplib
  str
  unix
  ctypes
  ctypes.foreign
  utils
  ppx_minidebug.runtime
  ppx_minidebug.db)
 (foreign_stubs
  (language c)
  (names builtins))
 (preprocess
  (pps
   ppx_compare
   ppx_enumerate
   ppx_hash
   ppx_here
   ppx_sexp_conv
   ppx_string
   ppx_variants_conv
   ppx_minidebug))
 (modules
  ops
  interval
  numerics
  resource_fault_injection
  alloc_census
  ndarray
  indexing
  affine
  tnode
  host_inits
  schedule_outcome
  register_tile
  low_level
  cost_model
  schedule_space
  schedule
  schedule_cache
  assignments
  task
  backend_intf
  backend_impl
  compiler_options
  c_syntax)
 (modes best))

