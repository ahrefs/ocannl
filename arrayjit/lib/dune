(library
 (name context)
 (public_name arrayjit.context)
 (preprocessor_deps
  (env_var OCANNL_LOG_LEVEL_CC_BACKEND)
  (env_var OCANNL_LOG_LEVEL_SCHEDULERS)
  (env_var OCANNL_LOG_LEVEL_BACKENDS))
 (libraries
  base
  printbox
  printbox-text
  stdio
  sexplib
  str
  ctypes
  ctypes.foreign
  utils
  ir
  (select
   cuda_backend_impl.ml
   from
   (cuda_backend -> cuda_backend_impl.cudajit.ml)
   (-> cuda_backend_impl.missing.ml))
  (select
   hip_backend_impl.ml
   from
   (hip_backend -> hip_backend_impl.hipjit.ml)
   (-> hip_backend_impl.missing.ml))
  (select
   metal_backend_impl.ml
   from
   (metal_backend -> metal_backend_impl.metal.ml)
   (-> metal_backend_impl.missing.ml))
  ppx_minidebug.runtime
  ppx_minidebug.db)
 (preprocess
  (pps
   ppx_compare
   ppx_enumerate
   ppx_hash
   ppx_here
   ppx_sexp_conv
   ppx_string
   ppx_variants_conv
   ppx_minidebug))
 (modules
  cc_backend
  builtins_cc
  cuda_backend_impl
  hip_backend_impl
  metal_backend_impl
  lowered_backend_missing
  no_device_backend_missing
  schedulers
  backends
  context)
 (modes best))

(library
 (name memory_budget)
 (public_name arrayjit.memory_budget)
 (libraries base stdio utils ir context)
