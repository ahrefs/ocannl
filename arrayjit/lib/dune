; The C builtin definition table (gh-ocannl-656) is stdlib-only and a library of its own, so the
; stdlib-only consumers -- gen_builtins, whose header ir's C stubs need before context can build,
; and the test-side scanners and header generators -- link it without linking a backend.

(library
 (name builtins_cc)
 (public_name arrayjit.builtins_cc)
 (modules builtins_cc))

; The CUDA and HIP definition tables are strings too, so they are stdlib-only libraries beside it
; rather than modules of the optional backend libraries (gh-ocannl-1353): every `dune build @check`
; compiles them, on machines with neither cudajit nor hipjit -- per-PR CI among them -- and a host
; test (test/operations/cuda_like_builtins_emulation) links them to compile their device-free
; conversion helpers with the host C compiler and compare them with the C table's.

(library
 (name builtins_cuda)
 (public_name arrayjit.builtins_cuda)
 (modules builtins_cuda)
 (libraries builtins_cc))

(library
 (name builtins_hip)
 (public_name arrayjit.builtins_hip)
 (modules builtins_hip)
 (libraries builtins_cc))

(library
 (name context)
 (public_name arrayjit.context)
 (preprocessor_deps
  (env_var OCANNL_LOG_LEVEL_CC_BACKEND)
  (env_var OCANNL_LOG_LEVEL_SCHEDULERS)
  (env_var OCANNL_LOG_LEVEL_BACKENDS))
 (libraries
  base
  printbox
  printbox-text
  stdio
  sexplib
  str
  ctypes
  ctypes.foreign
  utils
  ir
  builtins_cc
  (select
   cuda_backend_impl.ml
   from
   (cuda_backend -> cuda_backend_impl.cudajit.ml)
   (-> cuda_backend_impl.missing.ml))
  (select
   hip_backend_impl.ml
   from
   (hip_backend -> hip_backend_impl.hipjit.ml)
   (-> hip_backend_impl.missing.ml))
  (select
   metal_backend_impl.ml
   from
   (metal_backend -> metal_backend_impl.metal.ml)
   (-> metal_backend_impl.missing.ml))
  ppx_minidebug.runtime
  ppx_minidebug.db)
 (preprocess
  (pps
   ppx_compare
   ppx_enumerate
   ppx_hash
   ppx_here
   ppx_sexp_conv
   ppx_string
   ppx_variants_conv
   ppx_minidebug))
 (modules
  cc_backend
  cuda_backend_impl
  hip_backend_impl
  metal_backend_impl
  lowered_backend_missing
  no_device_backend_missing
  schedulers
  backends
  context)
 (modes best))

