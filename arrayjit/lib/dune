  kernel_code_cache
  ndarray
  indexing
  affine
  tnode
  host_inits
  schedule_outcome
  vector_file
  register_tile
  low_level
  online_softmax
  winograd
  fp_algebra
  rewrites
  cost_model
  schedule_space
  schedule
  schedule_cache
  assignments
  task
  backend_intf
  backend_impl
  compiler_options
  c_syntax
  cuda_like_config
  cuda_mma
  metal_mma
  hip_mma)
 (modes best))

