; Metal backend tests. The Metal backend (the `metal` opam package + the
; `(optional)` `arrayjit.metal_backend` library) is Apple-only — `arrayjit.opam`
; depends on `metal {= :os macos}`, so off macOS those libraries are absent.
;
; We cannot just gate the stanza: an `enabled_if` on a `(test)` does NOT stop
; dune from resolving its `(libraries)`, so a disabled test still requires the
; hidden optional lib and the build fails with "arrayjit.metal_backend ... is
; hidden". Instead we keep the test ALWAYS building and pick the implementation
; with dune `select` (the same mechanism `arrayjit/lib/dune` uses for
; `metal_backend_impl`): where `metal` + `arrayjit.metal_backend` are available
; the real test runs; elsewhere a stub (`*.missing.ml`, linking neither) is
; selected and reproduces the recorded golden so the test passes trivially.

(test
 ; ocannl-backend: metal -- goes at Metal_backend.Impl by name (get_device, alloc_pool,
 ; storage_mode_of_pool). The `select` above picks the arm by library availability, not by the
 ; environment, and the off-platform arm replays the golden.
 (name test_metal_storage_mode)
 (package arrayjit)
 (modules test_metal_storage_mode)
 (deps ocannl_config test_metal_storage_mode.expected)
 (libraries
  base
  stdio
  (select
   test_metal_storage_mode.ml
   from
   (metal
    arrayjit.metal_backend
    arrayjit.ir
    ->
    test_metal_storage_mode.real.ml)
   (-> test_metal_storage_mode.missing.ml))))

(test
 ; ocannl-backend: metal -- drives Metal_backend.Impl directly (alloc_pool, make_context,
 ; from_host/to_host); the `select` arm follows library availability, not OCANNL_BACKEND.
 (name test_metal_alloc)
 (package arrayjit)
 (modules test_metal_alloc)
 (deps ocannl_config test_metal_alloc.expected)
 (libraries
  base
  stdio
  arrayjit.verdict
  (select
   test_metal_alloc.ml
   from
   (metal arrayjit.metal_backend arrayjit.ir -> test_metal_alloc.real.ml)
   (-> test_metal_alloc.missing.ml))))

; The CUDA arm of gh-ocannl-536's failure classification. Same `select` reasoning as the Metal
; tests above: `arrayjit.cuda_backend` is `(optional)` on cudajit, and an `enabled_if` would not
; stop dune from resolving the hidden library.

(test
 ; ocannl-backend: cuda -- calls Cuda_backend.Impl.classify_failure and raises through the CUDA
 ; bindings; it self-skips on a machine with no device, which is hardware, not configuration.
 (name test_cuda_classify_failure)
 (package arrayjit)
 (modules test_cuda_classify_failure)
 (deps ocannl_config test_cuda_classify_failure.expected)
 (libraries
  base
  stdio
  (select
   test_cuda_classify_failure.ml
   from
   (cudajit.cuda
    cudajit.nvrtc
    arrayjit.cuda_backend
    arrayjit.ir
    ->
    test_cuda_classify_failure.real.ml)
   (-> test_cuda_classify_failure.missing.ml))))

