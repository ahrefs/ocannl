; `arrayjit/lib/metal_backend.ml` compiled against the `metal` stand-in one directory up
; (`arrayjit/vendor_stubs/dune` describes the arrangement). One library per genuine stanza, each
; with its stanza's preprocessing and libraries, `metal_stub` in place of `metal` and
; `metal.runtime`: `metal_math_api_runtime` (its own optional library in `arrayjit/lib/dune`), the
; `metal_backend` library over it, and the `select` arm `arrayjit.context` compiles.
; `test/operations/vendor_stub_arms_scan` refuses a library here that the genuine stanza does not
; declare (gh-ocannl-2288). The IOKit C stubs are left out: their `external` declaration
; type-checks without them, and nothing links these libraries.

(copy_files#
 (files ../../../lib/metal_backend.{ml,mli}))

(copy_files#
 (files ../../../lib/metal_backend_impl.mli))

(copy_files#
 (files ../../../lib/metal_math_api_runtime.{ml,mli}))

; The vendor arm of `arrayjit.context`'s `select`, checked against the interface its fallback arm
; also satisfies.

(rule
 (action
  (copy# ../../../lib/metal_backend_impl.metal.ml metal_backend_impl.ml)))

; `metal_math_api_runtime` as its own optional library in `arrayjit/lib/dune` compiles it.

(library
 (name metal_math_api_runtime_stub_check)
 (wrapped false)
 (modules metal_math_api_runtime)
 (libraries metal_stub ir))

(library
 (name metal_backend_stub_check)
 (wrapped false)
 (modules metal_backend)
 (preprocessor_deps
  (env_var OCANNL_LOG_LEVEL_METAL_BACKEND))
 (libraries
  base
  mtime
  mtime.clock.os
  metal_stub
  metal_math_api_runtime_stub_check
  utils
  ir
  builtins_cc
  builtins_metal
  integers
  unix
  ctypes
  pprint
  stdio)
 (preprocess
  (pps
   ppx_compare
   ppx_hash
   ppx_here
   ppx_sexp_conv
   ppx_string
   ppx_variants_conv
   ppx_minidebug)))

; The arm on its own, with `arrayjit.context`'s `ir` and the backend its `select` condition names;
; no preprocessing, as the arm uses none (a ppx it ever takes up goes here too).

(library
 (name metal_backend_impl_arm)
 (wrapped false)
 (modules metal_backend_impl)
 (libraries ir metal_backend_stub_check))
