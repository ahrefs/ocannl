; `arrayjit/lib/cuda_backend.ml` compiled against the `cudajit` stand-in one directory up
; (`arrayjit/vendor_stubs/dune` describes the arrangement). The stanza mirrors the `cuda_backend`
; library in `arrayjit/lib/dune` -- same preprocessing, same `arrayjit` libraries -- with
; `cudajit_stub` in place of `cudajit.cuda` and `cudajit.nvrtc`.

(copy_files#
 (files ../../../lib/cuda_backend.{ml,mli}))

(copy_files#
 (files ../../../lib/cuda_backend_impl.mli))

; The vendor arm of `arrayjit.context`'s `select`, checked against the interface its fallback arm
; also satisfies.

(rule
 (action
  (copy# ../../../lib/cuda_backend_impl.cudajit.ml cuda_backend_impl.ml)))

(library
 (name cuda_backend_stub_check)
 (modules cuda_backend cuda_backend_impl)
 (preprocessor_deps
  (env_var OCANNL_LOG_LEVEL_CUDA_BACKEND))
 (libraries base cudajit_stub utils ir builtins_cc builtins_cuda)
 (preprocess
  (pps
   ppx_compare
   ppx_hash
   ppx_here
   ppx_sexp_conv
   ppx_string
   ppx_variants_conv
   ppx_minidebug)))
