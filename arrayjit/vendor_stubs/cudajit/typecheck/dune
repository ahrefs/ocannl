; `arrayjit/lib/cuda_backend.ml` compiled against the `cudajit` stand-in one directory up
; (`arrayjit/vendor_stubs/dune` describes the arrangement). One library per genuine stanza: the
; first mirrors the `cuda_backend` library in `arrayjit/lib/dune` -- same preprocessing, same
; libraries, with `cudajit_stub` in place of `cudajit.cuda` and `cudajit.nvrtc` -- and the second
; compiles the `select` arm `arrayjit.context` compiles. `test/operations/vendor_stub_arms_scan`
; refuses a library here that the genuine stanza does not declare (gh-ocannl-2288).

(copy_files#
 (files ../../../lib/cuda_backend.{ml,mli}))

(copy_files#
 (files ../../../lib/cuda_backend_impl.mli))

; The vendor arm of `arrayjit.context`'s `select`, checked against the interface its fallback arm
; also satisfies.

(rule
 (action
  (copy# ../../../lib/cuda_backend_impl.cudajit.ml cuda_backend_impl.ml)))

(library
 (name cuda_backend_stub_check)
 (wrapped false)
 (modules cuda_backend)
 (preprocessor_deps
  (env_var OCANNL_LOG_LEVEL_CUDA_BACKEND))
 (libraries
  base
  cudajit_stub
  unix
  utils
  ir
  builtins_cc
  builtins_cuda
  integers
  stdio
  pprint)
 (preprocess
  (pps
   ppx_compare
   ppx_hash
   ppx_here
   ppx_sexp_conv
   ppx_string
   ppx_variants_conv
   ppx_minidebug)))

; The arm on its own, as `arrayjit.context` compiles it: with that library's `ir`, and the backend
; its `select` condition names.

(library
 (name cuda_backend_impl_arm)
 (wrapped false)
 (modules cuda_backend_impl)
 (libraries ir cuda_backend_stub_check))
