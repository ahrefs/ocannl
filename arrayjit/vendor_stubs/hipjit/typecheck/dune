; `arrayjit/lib/hip_backend.ml` compiled against the `hipjit` stand-in one directory up
; (`arrayjit/vendor_stubs/dune` describes the arrangement). One library per genuine stanza: the
; first mirrors the `hip_backend` library in `arrayjit/lib/dune` -- same preprocessing, same
; libraries, with `hipjit_stub` in place of `hipjit.hip` and `hipjit.hiprtc` -- and the second
; compiles the `select` arm `arrayjit.context` compiles. `test/operations/vendor_stub_arms_scan`
; refuses a library here that the genuine stanza does not declare (gh-ocannl-2288).

(copy_files#
 (files ../../../lib/hip_backend.{ml,mli}))

(copy_files#
 (files ../../../lib/hip_backend_impl.mli))

; The vendor arm of `arrayjit.context`'s `select`, checked against the interface its fallback arm
; also satisfies.

(rule
 (action
  (copy# ../../../lib/hip_backend_impl.hipjit.ml hip_backend_impl.ml)))

(library
 (name hip_backend_stub_check)
 (wrapped false)
 (modules hip_backend)
 (preprocessor_deps
  (env_var OCANNL_LOG_LEVEL_HIP_BACKEND))
 (libraries
  base
  hipjit_stub
  ctypes
  ctypes.foreign
  utils
  ir
  builtins_cc
  builtins_hip
  integers
  unix
  stdio
  pprint)
 (preprocess
  (pps
   ppx_compare
   ppx_hash
   ppx_here
   ppx_sexp_conv
   ppx_string
   ppx_variants_conv
   ppx_minidebug)))

; The arm on its own, with `arrayjit.context`'s `ir` and the backend its `select` condition names;
; no preprocessing, as the arm uses none (a ppx it ever takes up goes here too).

(library
 (name hip_backend_impl_arm)
 (wrapped false)
 (modules hip_backend_impl)
 (libraries ir hip_backend_stub_check))
