(copy_files
 (files ../test/config/ocannl_config))

(copy_files
 (files ../test/config/env_spelling_gate.ml))

; `@bin-smoke` is a cached build entry point like every test-family alias, so rejected legacy
; OCANNL environment spellings need an always-rerun gate of their own (gh-ocannl-652). Keeping the
; gate on a prerequisite alias makes it complete before any smoke command starts.

(executable
 (name env_spelling_gate)
 (modules env_spelling_gate)
 (libraries base stdio arrayjit.utils arrayjit.verdict))

(rule
 ; ocannl-backend: none -- links arrayjit.utils alone and only classifies variable names.
 (alias bin-smoke-env_spelling_gate)
 (package neural_nets_lib)
 (deps ocannl_config (universe))
 (action
  (run %{dep:env_spelling_gate.exe})))

; The commandline split every tool here needs: positional geometry beside the library's
; --ocannl_* configuration flags (gh-ocannl-634). A library rather than a module shared by
; (modules ...) lists, because dune allows a module in only one stanza, and because two test
; executables outside this directory parse their arguments the same way.

(library
 (name bench_args)
 (package neural_nets_lib)
 (modules bench_args)
 ; arrayjit.utils only for `cmdline_arg_is_config_key`: the split has to be able to say when a
 ; post-`--` positional is one the library's own argv scan has already applied as configuration.
 (libraries base stdio arrayjit.utils))

; The checksum machinery the matmul-shaped benches share (gh-ocannl-711): the aperiodic (row,
; column) mix, the operand residues drawn from it, and the position-weighted whole-output checksum.
; A library rather than a module listed twice, because dune allows a module in only one stanza; its
; own library rather than a second module of `bench_args`, because a wrapped library named after its
; single module is what makes `Bench_args.` and `Bench_checksum.` both spell directly. Depends on
; base alone -- the discrimination test that pins it links no backend.

; The flushed line printer every tool here reports through (gh-ocannl-829): OCaml's stdout is
; block-buffered, so an unflushed bench that is minutes per leg produces no output at all until it
; exits, which reads as a hang. Its own library for the same reason `bench_checksum` is one -- dune
; allows a module in only one stanza -- and separate from `bench_args` because printing and
; positional-geometry parsing are not the same set of tools.

(library
 (name bench_out)
 (package neural_nets_lib)
 (modules bench_out)
 (libraries stdio))

(library
 (name bench_checksum)
 (package neural_nets_lib)
 (modules bench_checksum)
 (libraries base))

; The register-tile geometry request the two C-backend GEBP benches share (gh-ocannl-620
; follow-up): `--tile=rm,rn,lanes` / `--rn=N` parsed once, so `narrow_gebp_bench` and
; `schedule_bench` cannot disagree about the spelling or about what `--rn=` derives. Its own
; library for the same reason the three above are -- dune allows a module in only one stanza -- and
; separate from `bench_args` because that one deliberately depends on no backend, while the
; geometry and its ladder are `arrayjit.ir` types.

(library
 (name bench_tile)
 (package neural_nets_lib)
 (modules bench_tile)
 (libraries base arrayjit.ir bench_args))

(executable
 (package neural_nets_lib)
 (public_name compilation_speed_benchmark)
 (name compilation_speed)
 (modules compilation_speed)
 (libraries ocannl base stdio time_now dataprep bench_args bench_out)
 (preprocess
  (pps ppx_here ppx_sexp_conv ppx_string ppx_ocannl ppx_minidebug ppx_here))
 (modes exe))

(executable
 (package neural_nets_lib)
 (public_name schedule_bench)
 (name schedule_bench)
 (modules schedule_bench)
 (libraries
  ocannl
  base
  stdio
  time_now
  bench_args
  bench_checksum
  bench_out
  bench_tile)
 (preprocess
  (pps ppx_here ppx_ocannl))
 (modes exe))

; Runtime canary for every user-facing executable in this directory (gh-ocannl-858). This checks
; only that each tool starts and completes: the workloads are intentionally too small to support
; any claim about the measurements, whose hermeticity and validity belong to gh-ocannl-743. One
; sequential action keeps CPU and linker pressure bounded on shared and CI machines. The alias is
; included in the main CI Dune walk; keeping it outside `runtest` also makes the policy and its cost
; visible at the call site as `dune build @bin-smoke`. The gh-ocannl-874 scans-family check derives
; this action's executable members and holds them equal to the public executable declarations below.

(rule
 ; ocannl-backend: cc -- every command pins the runtime canary to the cheap CPU backend.
 (alias bin-smoke)
 (package neural_nets_lib)
 ; The membership scan requires every command-bearing contribution to rerun rather than become a
 ; cached alias action; the environment gate has the same dependency for the same reason.
 (deps
  (alias bin-smoke-env_spelling_gate)
  ocannl_config
  (universe))
 (action
  (progn
   (run %{exe:compilation_speed.exe} 1 --ocannl_backend=cc)
   (run %{exe:schedule_bench.exe} 2 1 2 2 1 --ocannl_backend=cc)
   (run %{exe:cpu_vectorization_bench.exe} 2 1 --ocannl_backend=cc)
   (run %{exe:narrow_storage_bench.exe} 2 1 1 --ocannl_backend=cc)
   (run %{exe:narrow_gebp_bench.exe} f32 2 1 1 1 --ocannl_backend=cc)
   (run %{exe:device_props.exe} --ocannl_backend=cc)
   ; --allow-unmeasured: this canary asks whether the pipeline runs end to end, and a shared CI
   ; runner can refuse every timing window of a 2x2 cell for host contention (gh-ocannl-855) --
   ; a fact about the machine, not about the code path. The refusal still prints its `!!` line;
   ; a parity or compile failure still exits 1, as does a refusal in an ordinary bench run.
   (run
    %{exe:projection_shape_bench.exe}
    2
    2
    smoke
    fwd
    seeds
    --allow-unmeasured
    --ocannl_backend=cc))))

