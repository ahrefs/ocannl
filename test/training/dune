  (pps ppx_here ppx_ocannl)))

(rule
 (alias train-bigram)
 (package neural_nets_lib)
 (locks ocannl_training_test)
 (deps
  (alias train-env_spelling_gate)
  bigram.expected
  ocannl_config
  (env_var OCANNL_BACKEND))
 ; no-infer keeps the tutorial off @default as well as @runtest.
 (action
  (no-infer
   (progn
    (with-stdout-to
     bigram.actual
     (run %{dep:bigram.exe}))
    (diff bigram.expected bigram.actual)))))

