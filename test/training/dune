; transformer_names is a transformer training integration run on the `train` tier (see
; circles_conv): the longest member of the serialized `ocannl_training_test` chain on Linux
; (~246s cc on a 24-thread box, ~132s cc on the reference Mac, batch 128 / 2.5k steps). Its sgd
; step is autotuned (materialized intermediates + Autotune.tune), the whole one-hot dataset lives
; on device (batches via @| batch_n — no per-step host transfers), and the loss accumulates on
; device so the loop syncs once per epoch.
;
; The three sampled names at the end of the run are the human-legible canary that the model learned
; name structure -- the loss thresholds are their quantitative proxy, not their replacement -- and
; they are exact by construction, so ONE golden serves every backend: all five agree byte for byte
; across three vendors' hardware and both CPU schedulers, the trajectory being a fixed sequence of
; batches at a fixed learning-rate schedule and the autotune seeds preserving reduction order. The
; static-index snapshot in `Backends.Add_device` is what makes that true of the asynchronous
; scheduler too (`test/operations/async_launch_bindings` pins it): a dispatch launches on the index
; bound for it, so `multidev_cc` runs the same sweep of batches as `cc`. Re-record with
; `OCANNL_BACKEND=<b> dune build @test/training/train-transformer_names` and `dune promote`; on a
; backend-uniform golden, confirm which backend actually ran from the run's stderr rather than from
; the diff passing, since a wrong backend would pass against the same golden.

(executable
 (name transformer_names)
 (modules transformer_names)
 (libraries ocannl dataprep arrayjit.verdict training_golden)
 (preprocess
  (pps ppx_here ppx_ocannl)))

(rule
 (alias train-transformer_names)
 (package neural_nets_lib)
 (locks ocannl_training_test)
 (deps
  (alias slow-env_spelling_gate)
  transformer_names.expected
  ocannl_config
  (env_var OCANNL_BACKEND))
 ; no-infer keeps transformer_names.actual from becoming a build target, so plain `dune build`
 ; (@all) does not run this training exe -- only `@train` and `@train-transformer_names` do.
 (action
  (no-infer
   (progn
    (with-stdout-to
     transformer_names.actual
     (run %{dep:transformer_names.exe}))
    (diff transformer_names.expected transformer_names.actual)))))

