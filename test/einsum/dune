(copy_files
 (files ../config/ocannl_config))

; The ambient-environment gate (gh-ocannl-652). `(universe)` makes dune rerun it on every
; invocation, which is the only way a rejected environment spelling reaches a check at all:
; every other rule here is cached against declarations that no longer name those spellings,
; so `ocannl_backend=cuda dune build @test/einsum/runtest` would otherwise serve this
; directory's previous run wholesale. One per test directory, because dune aliases are per
; directory; the source is shared, and its header says why the dependency is the world
; rather than 112 key names.

(copy_files
 (files ../config/env_spelling_gate.ml))

(test
 ; ocannl-backend: none -- links arrayjit.utils alone and only classifies variable NAMES;
 ; its `(universe)` dependency reruns it whatever any variable is set to.
 (name env_spelling_gate)
 (package neural_nets_lib)
 (deps ocannl_config (universe))
 (modules env_spelling_gate)
 (libraries base stdio arrayjit.utils arrayjit.verdict))

; The same gate for the per-test `runtest-<name>` aliases (gh-ocannl-703, gh-ocannl-726). Every rule
; that diffs a golden sits on an alias of its own, so that ONE of them can be rerun targeted --
; `dune build @test/einsum/runtest-inline_permuted_view-c_fwd` -- and a per-test alias is a build
; entry point like any other, so the ambient gate has to reach it. It sits on an alias of its own
; that every such rule DEPENDS on, which runs the gate BEFORE the diff -- the same shape the slow
; rules use. The name is the one dune >= 3.20 generates for the `env_spelling_gate` `(test)` stanza
; above: a rule may add an action to a generated per-test alias, and this one runs the same gate
; binary, so the alias means the same thing whichever dune is building.

(rule
 ; ocannl-backend: none -- links arrayjit.utils alone and only classifies variable NAMES;
 ; its `(universe)` dependency reruns it whatever any variable is set to.
 (alias runtest-env_spelling_gate)
 (package neural_nets_lib)
 (deps ocannl_config (universe))
 (action
  (run %{dep:env_spelling_gate.exe})))

; This directory's golden-diff rules, aggregated back onto `runtest` (gh-ocannl-726). Each of them
; attaches to its own `runtest-<name>` alias and to NOTHING else, so that `dune build
; @test/einsum/runtest-inline_permuted_view-c_fwd` runs that one test and applies its diff; this
; stanza is what keeps `dune runtest` running all of them. Attaching such a rule to `runtest` as
; well would defeat the point: a rule on two aliases makes building either alias build both, so a
; per-test alias that also named `runtest` would pull the whole directory in behind it -- and where
; the name is one dune generates for a `(test)` stanza, dune rejects the pair outright as a
; dependency cycle. Hence the naming: `<name>` is the golden the rule checks, and never a `(test)`
; stanza's name in this directory. A `runtest-<name>` rule missing from this list is one plain `dune
; runtest` skips silently, which `test/operations/env_var_deps` checks -- the same check it makes of
; the `slow` suite.

(alias
 (name runtest)
 (deps
  (alias runtest-inline_permuted_view-c_fwd)
  (alias runtest-test_cse-cse_d_fwd)))

