(rule
 (alias runtest-inline_permuted_view-c_fwd)
 (package neural_nets_lib)
 (target inline_permuted_view-c_fwd.ll.actual)
 (deps
  (alias runtest-env_spelling_gate)
  ocannl_config
  (env_var OCANNL_BACKEND))
 (action
  (no-infer
   (progn
    (run
     %{dep:inline_permuted_view.exe}
     "--ocannl_output_debug_files_in_build_directory=true"
     "--ocannl_build_files_prefix=inline_permuted_view")
    (copy build_files/inline_permuted_view/c_fwd.ll %{target})))))

(rule
 (alias runtest-inline_permuted_view-c_fwd)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff
   "inline_permuted_view-c_fwd.ll.expected"
   "inline_permuted_view-c_fwd.ll.actual")))

