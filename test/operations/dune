; gh-ocannl-438 follow-up: the repository's shell scripts parse. Neither `dune build @check` nor
; `dune runtest` looks at shell otherwise, while `scripts/setup-ocaml-env.sh` is the SessionStart
; hook and `tools/test-run.sh` fronts every suite run -- so a syntax error in either is discovered
; by a broken session or a broken suite run rather than by a test. `bash -n` / `sh -n` parse and
; execute nothing.
;
; `(glob_files_rec ../../*.sh)` is both the discovery mechanism and the reason dune reruns this when
; a script changes; `%{deps}` hands the whole set to the exe, which keeps the .sh files among them.
; A `(rule)` rather than a `(test)` because the glob has to be a dependency of the action that runs
; the executable, and the marker comment and `ocannl_config` go with it.

(executable
 (name shell_scripts_parse)
 (modules shell_scripts_parse)
 (libraries base stdio unix test_utils arrayjit.verdict))

(rule
 ; ocannl-backend: none -- links no backend: it hands shell scripts to `bash -n`/`sh -n` and runs no kernels.
 (target shell_scripts_parse.actual)
 (package neural_nets_lib)
 (deps
  ocannl_config
  (glob_files_rec ../../*.sh)
  ; A shell script need not be named `*.sh` -- `tools/run-tests` with a `#!/bin/bash` would have
  ; slipped through the suffix glob, and the floor would not have noticed since the twelve suffixed
  ; ones keep it satisfied (Codex review round 6). These two globs hand over EVERY file in the two
  ; directories that hold this repository's tooling; the scanner picks out the ones whose first two
  ; bytes are `#!` and whose interpreter is a shell, and ignores the rest. Bounded on purpose:
  ; globbing the whole repository would make this rule depend on every source file in it and rerun
  ; on every commit, for a case that only arises where executables live.
  (glob_files_rec ../../tools/*)
  (glob_files_rec ../../scripts/*)
  ; PATH decides WHICH shell each name resolves to, so it decides what grammar a script was held
  ; to -- a host whose `sh` is dash and one whose `sh` is bash are running different checks, and a
  ; missing `dash` changes whether a stand-in was substituted at all. Undeclared, dune would serve
  ; the previous PATH's result unchanged (Codex review round 3 on PR #454; the same rule AGENTS.md
  ; states for OCANNL_* spellings applies to any variable a run reads).
  ;
  ; BASH_ENV and friends are deliberately NOT declared: the executable clears them for the child
  ; instead, so they cannot influence the run and need no dependency edge (round 6).
  (env_var PATH))
 (action
  (with-stdout-to
   %{target}
   (run %{dep:shell_scripts_parse.exe} %{workspace_root} %{deps}))))

(rule
 (alias runtest-shell_scripts_parse)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff shell_scripts_parse.expected shell_scripts_parse.actual)))

; gh-ocannl-790: command-line configuration flags in shell scripts and configuration assignments in
; prose are consumers of the key registry too. The OCaml-source scanners cannot see either, so a
; rename otherwise leaves them behind until a reviewer remembers the site.
;
; Source membership comes from `Test_utils.Source_inventory`. Every checked-in `*.sh` and `*.py`
; is in scope independent of which root contains it; the existing user-help and implementation
; `*.ml`/`*.mli` scope is selected from that inventory, with generated `*.pp.ml`/`*.pp.mli`
; renderings excluded. File-kind non-vacuity claims keep a missing class loud without duplicating
; script-root membership. Qualified
; command-line spellings and value separators accepted by
; Utils.cmdline_var_prefixes, and identifier-delimited `OCANNL_<KEY>` mentions, are consumers.
; Supported prefix-free flags are file/key/count-pinned because their namespace belongs to the host
; application and cannot safely be claimed globally; the runtime's per-key qualified-only policy
; decides whether those spellings exist.
; The existing AGENTS/root-README/docs/benchmarks/skill Markdown scope and workflow YAML scope are
; selected from the inventory too.
; Benchmark reports contribute only prefixed tokens; every Markdown fence contributes prefixed
; tokens (including every physical segment of a multiline span), and elsewhere a bare assignment may
; occupy the whole inline span when its name has lowercase snake-case shape with an underscore
; (with optional whitespace around `=` or in its value). `Utils.parse_config_token` owns that grammar
; together with the command-line and environment forms. Embedded prefixed tokens and the outer bare
; assignment are both checked. Every
; checked-in dune file contributes action arguments, and every checked-in
; ocannl_config plus the ready-to-copy ocannl_config.for_debug contribute their runtime-normalized
; assignment keys, retaining empty keys for registry rejection (and including commented
; ready-to-enable assignments in the latter). The action's generated local copy is excluded from
; source membership. Prefixed tokens and whole-span inline assignments in ocannl_config.reference
; join too.
; Non-config judgments,
; spaced bare config mentions, ambiguous alternate-value spellings, and intentional-invalid
; exemptions pin file/key occurrence counts.
; The checked-in fixture carries one unknown key in every accepted syntax, and the control requires
; refusal with exit 1.

(executable
 (name config_usage_scan)
 (modules config_usage_scan)
 (libraries base stdio arrayjit.utils test_utils arrayjit.verdict))

(rule
 ; ocannl-backend: none -- links no backend: it reads shell scripts and Markdown as text.
 ; The clean sandbox holds the declared source tree without Git metadata or stale build outputs.
 ; The scanner enumerates it in-process, preserving whitespace boundaries and keeping the source
 ; list off Windows' length-limited command line. Its own executable, redirected output, and the
 ; mandatory copied local config are generated sandbox occupants and are excluded explicitly.
 (target config_usage_scan.actual)
 (package neural_nets_lib)
 (deps
  ocannl_config
  (sandbox always)
  (source_tree ../..))
 (action
  (with-stdout-to
   %{target}
   (run
    %{dep:config_usage_scan.exe}
    %{workspace_root}
    %{target}
    %{dep:config_usage_scan.exe}
    %{dep:ocannl_config}))))

(rule
 ; ocannl-backend: none -- runs the same text scanner on a synthetic unknown key and requires its
 ; refusal; it links no backend and runs no OCANNL program.
 (target config_usage_scan_control.actual)
 (package neural_nets_lib)
 (deps
  ocannl_config
  config_usage_scan_bogus.fixture
  config_usage_scan_bogus_config.fixture
  config_usage_scan_multiline_bogus.fixture)
 (action
  (setenv
   OCANNL_LOG_CONFIG_SOURCING
   false
   (setenv
    OCANNL_NO_CONFIG_FILE
    false
    (setenv
     OCANNL_SUPPRESS_WELCOME_MESSAGE
     true
     (setenv
      OCANNL_PROFILE
      ""
      (with-stderr-to
       %{target}
       (ignore-stdout
        (with-accepted-exit-codes
         1
         (run
          %{dep:config_usage_scan.exe}
          --fixture
          %{dep:config_usage_scan_bogus.fixture}
          %{dep:config_usage_scan_bogus_config.fixture}
          %{dep:config_usage_scan_multiline_bogus.fixture}))))))))))

(rule
 (alias runtest-config_usage_scan)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff config_usage_scan.expected config_usage_scan.actual)))

(rule
 (alias runtest-config_usage_scan_control)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff config_usage_scan_control.expected config_usage_scan_control.actual)))

(rule
 ; ocannl-backend: none -- drives every direct config-usage refusal through injected state.
 (target config_usage_scan_refusal_control.actual)
 (package neural_nets_lib)
 (deps
