  (env_var XDG_CACHE_HOME)
  (env_var HOME)
  (env_var SDKROOT)
  (env_var MACOSX_DEPLOYMENT_TARGET)
  (env_var CPATH)
  (env_var C_INCLUDE_PATH)
  (env_var COMPILER_PATH)
  (env_var GCC_EXEC_PREFIX)
  (env_var AARCH64_CROSS_GCC)
  (universe)
  ocannl_config)
