; gh-ocannl-712: what in this tree pins the TEXT of generated code, enumerated. The blast radius of
; a codegen change is two populations no single search finds -- goldens holding emitted kernel or IR
; source, in `test/` and `arrayjit/test/` BOTH, and test sources asserting on emitted text from a
; string literal, which no `.expected` scan can see and which fail a plain `dune build` because they
; are Verdict claims. gh-ocannl-623 missed one of each and went red in CI. The globs are recursive
; over the test directories of both packages, so a directory added is covered the day it appears,
; and `%{deps}` hands the whole dependency set to the exe, which keeps the goldens and the sources
; among them.

(executable
 (name codegen_text_inventory)
 (modules codegen_text_inventory)
 (libraries base stdio test_utils emitter_frontier arrayjit.verdict))

; The `.cmi` dependencies are the emitter frontier's source (gh-ocannl-748): the set of values that
; hand a test generated text is derived from the compiler libraries' compiled interfaces rather than
; listed in the scan. Both spellings of each library are asked for, because which one exists depends
; on how dune was invoked, and a derivation handed nothing reports a smaller census rather than an
; error:
;
;   - the object directory holds every module's interface in an ordinary in-workspace build, and the
;     glob is what forces them to be built;
;   - `%{lib:...}` resolves the wrapper interface in a PACKAGE-FILTERED build (`dune build -p
;     neural_nets_lib`, which each .opam file's build command runs), where arrayjit's own stanzas
;     are disabled and its libraries come from the switch instead. The member interfaces sit beside
;     that wrapper in the installed directory, and `Emitter_frontier` looks for them there.
;
; Both of `arrayjit.utils`' wrapper interfaces are named, and that is not belt-and-braces: the
; library has a module of its own name, so `utils.cmi` is that MODULE and dune's generated alias
; module -- the one that lists every member -- is `utils__.cmi`. Reading only the former discovers
; the members `utils.ml` happens to alias, which is the whole list today and need not stay so,
; while the declared-versus-read tripwire goes on passing over the shorter list. In a workspace
; build the object-directory glob hands over both; under `-p` only what is named here arrives.
;
; Whether the hand-over was complete is not assumed either way: the wrapper interface declares the
; library's modules, and the test fails when one of them was not read. Nor can the copies be stale:
; this executable links `test_utils`, which links `arrayjit.ir` and `arrayjit.utils`, so dune has
; compiled those interfaces for this very build before the rule runs.

(rule
 ; ocannl-backend: none -- links no backend: it reads goldens, test sources and compiled interfaces.
 ; Two targets: the file list is written by dune's own `echo`, which spawns nothing and so has
 ; no length limit, and handed over as a `@<path>` response file -- expanded into argv, a
 ; repository-wide list outgrows Windows' 32,767-character command line, where `CreateProcess`
 ; fails with `No such file or directory` and names neither. See `test/support/scan_argv.ml`.
 (targets codegen_text_inventory.actual codegen_text_inventory.filelist)
 (package neural_nets_lib)
 (deps
  ocannl_config
  %{lib:arrayjit.ir:ir.cmi}
  %{lib:arrayjit.utils:utils.cmi}
  %{lib:arrayjit.utils:utils__.cmi}
  (glob_files ../../arrayjit/lib/.ir.objs/byte/*.cmi)
  (glob_files ../../arrayjit/lib/.utils.objs/byte/*.cmi)
  (glob_files_rec ../../test/*.expected)
  (glob_files_rec ../../test/*.ml)
  (glob_files_rec ../../arrayjit/test/*.expected)
  (glob_files_rec ../../arrayjit/test/*.ml))
 (action
  (progn
   (with-stdout-to
    codegen_text_inventory.filelist
    (echo "%{deps}"))
   (with-stdout-to
    codegen_text_inventory.actual
    (run
     %{dep:codegen_text_inventory.exe}
     %{workspace_root}
     @codegen_text_inventory.filelist)))))

(rule
 (alias runtest-codegen_text_inventory)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff codegen_text_inventory.expected codegen_text_inventory.actual)))

