; gh-ocannl-605: every GitHub Actions job declares a runtime ceiling. A job without
; `timeout-minutes` runs to GitHub's 6-hour default, so one hung step spends six hours of runner
; time before anything notices. The ceilings were added to every job by hand; this holds the next
; job someone adds to the same rule. It reads the workflow files as lines -- no YAML library is a
; dependency here -- and decides only the block-mapping shape these files are written in: the
; top-level `jobs:` key, the job keys under it, and the keys under each job, with block scalars
; (`run: |`) skipped so a shell script contributes no keys.

(executable
 (name workflow_job_timeouts)
 (modules workflow_job_timeouts)
 (libraries base stdio test_utils arrayjit.verdict))

(rule
 ; ocannl-backend: none -- links no backend: it reads .github/workflows YAML as text.
 ; Two targets: the file list is written by dune's own `echo`, which spawns nothing and so has no
 ; length limit, and handed over as a `@<path>` response file rather than as argv -- the transport
 ; every repository-wide scan here uses, so no growth of the globbed set can reach Windows'
 ; 32,767-character command line. See `test/support/scan_argv.ml`.
 (targets workflow_job_timeouts.actual workflow_job_timeouts.filelist)
 (package neural_nets_lib)
 (deps
  ocannl_config
  ; Every file under the workflows directory, with no suffix list here: WHICH of them is a
  ; workflow is one fact, and it lives in the scanner's `is_workflow`, where the controls exercise
  ; it. A second copy in this glob could only drift -- silently, since the repository has no
  ; `.yaml` workflow today for a dropped spelling to fail on.
  (glob_files_rec ../../.github/workflows/*))
 (action
  (progn
   (with-stdout-to
    workflow_job_timeouts.filelist
    (echo "%{deps}"))
   (with-stdout-to
    workflow_job_timeouts.actual
    (run
     %{dep:workflow_job_timeouts.exe}
     %{workspace_root}
     @workflow_job_timeouts.filelist)))))

(rule
 (alias runtest-workflow_job_timeouts)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff workflow_job_timeouts.expected workflow_job_timeouts.actual)))

; tools/sweep.sh's incremental/forced distinction (gh-ocannl-737). This invokes
