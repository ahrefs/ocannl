   (glob_files_rec ../../*.ml)))
 (action
  (progn
   (with-stdout-to
    atomic_file_rename_scan.generators
    (echo "%{generators}"))
   (with-stdout-to
    atomic_file_rename_scan.generated
    (echo "%{generated}"))
   (with-stdout-to
    atomic_file_rename_scan.sources
    (echo "%{sources}"))
   (with-stdout-to
    atomic_file_rename_scan.actual
    (run
     %{dep:atomic_file_rename_scan.exe}
     %{workspace_root}
     --generators
     @atomic_file_rename_scan.generators
     --generated
     @atomic_file_rename_scan.generated
     --sources
     @atomic_file_rename_scan.sources)))))

