(test
 ; ocannl-backend: none -- drives Utils.resolve_config_value over synthetic alists; neither
 ; profile payload sets the backend key, so no precedence question here reaches one.
 (name config_profiles)
 (package neural_nets_lib)
 ; The executable guards on an ambient `OCANNL_PROFILE`, which would abort it during module
 ; initialization -- and a guard only RUNS when dune reruns the rule, which happens only for a
 ; variable it declares (gh-ocannl-749). `env_var_deps` pairs the key the guard reads with this
 ; declaration.
 (deps
  ocannl_config
  config_profiles.expected
  (env_var OCANNL_PROFILE))
 (modules config_profiles)
 (libraries base arrayjit.utils arrayjit.verdict stdio))

; gh-ocannl-605: the environment and commandline spellings of a configuration key. The rule sets
; the synthetic keys the executable looks up -- `demo_key` in the one environment spelling that
; survives and in the three dash-prefixed ones that do not, `dashed_only_key` in the dropped ones
; alone -- so the golden's last lines are a live check on `Utils.env_var_names`, not a copy of it.
; The all-dashed commandline flag is the same check on the other side: there the spelling IS read,
; and it names a real key, the unknown-argument warning being the reason (see the .ml). The BARE
; `ocannl_print_decimals_precision=9` in front of it is the negative: it is no longer a spelling
; (Codex P2 on PR #363), and being first in argv it would win if it were, so the golden's 7 is
; what says a bare argument stays the host's.
;
; EVERY spelling of both keys is stated here, the surviving ones as empty (which counts as unset at
; every source), so the rule's environment decides the output on its own: an ambient
; `OCANNL_DASHED_ONLY_KEY` would otherwise turn the negative leg's None into a value, and dune,
; which tracks no OCANNL variable but OCANNL_BACKEND, could serve the stale None besides (Codex P2
; on PR #363). Pinning beats declaring `env_var` deps wherever it is available: a pinned rule
; cannot be reached from the ambient environment at all.
;
; Windows environment names are case-INSENSITIVE, so `ocannl_demo_key` and `OCANNL_DEMO_KEY` are
; one variable there and two here; the fixture is written so that both readings produce the same
; golden (Codex P1 on PR #363). Two rules do it: a case pair that must be distinguishable is
; ordered so the value that has to survive is set LAST -- the empty `OCANNL_DEMO_KEY` outside the
; `ocannl_demo_key` that carries the value, so Windows' single variable ends up carrying it, and
; Linux reads the lowercase spelling first anyway -- and a case pair that is only there to be
; ignored carries ONE value in both spellings, so the control lines cannot report a collision.
; What is thereby not tested live is the case dimension itself; that is what `env_var_names`'
; printed list above covers, and `profiles/dune` exercises `OCANNL_PROFILE` end to end.

(executable
 (name config_var_spellings)
 (modules config_var_spellings)
 (libraries base arrayjit.utils stdio arrayjit.verdict))

(rule
 ; ocannl-backend: none -- classifies variable NAMES through Utils (env_var_name, classify_env_var);
 ; it never resolves the backend key's value, and links no backend to resolve it on.
 (target config_var_spellings.actual)
 (deps ocannl_config)
 (action
  ; The synthetic keys this fixture sets are, by construction, names no configuration key reads --
  ; so since gh-ocannl-629 each one draws the startup warning that the sibling
  ; `config_var_warnings` rule captures and pins. Here that stream is not the subject, and letting
  ; it through would only put four warnings in the build log on every rebuild of this target. They
  ; stay WARNINGS rather than the fatal error of the third rule below: `demo_key` is no key of
  ; OCANNL's, so no value of it was ever going to decide anything (gh-ocannl-652).
  ;
  ; Windows environment names are case-INSENSITIVE, so `ocannl_demo_key` and `OCANNL_DEMO_KEY` are
  ; ONE variable there: the value that must survive has to be the INNER (last) `setenv`, which is
  ; why the kept spelling is innermost. Same constraint as `profiles/dune`.
  (ignore-stderr
   (setenv
    ocannl_demo_key
    dropped-spelling
    (setenv
     OCANNL-DEMO_KEY
     dropped-spelling
     (setenv
      ocannl-demo_key
      dropped-spelling
      (setenv
       ocannl-demo-key
       dropped-spelling
       (setenv
        ocannl_dashed_only_key
        ""
        (setenv
         OCANNL-DASHED_ONLY_KEY
         dropped-spelling
         (setenv
          ocannl-dashed_only_key
          dropped-spelling
          (setenv
           OCANNL_DASHED_ONLY_KEY
           ""
           (setenv
            OCANNL_DEMO_KEY
            kept-spelling
            (with-stdout-to
             %{target}
             (run
              %{dep:config_var_spellings.exe}
              ocannl_print_decimals_precision=9
              --ocannl-print-decimals-precision=7
              --ocannl_log_level_0))))))))))))))

(rule
 (alias runtest-config_var_spellings)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff config_var_spellings.expected config_var_spellings.actual)))

; The other side of the same coin: what the library WARNS about. The unknown-argument check and
; `read_cmdline_var` now consult one table (`Utils.cmdline_var_prefixes`), so a spelling is read
; and unwarned, or unread and warned, never one of each -- which is what this rule captures, three
; arguments at a time: an all-dashed name with a `-` value separator, a dashed prefix over an
; underscored name with `=`, one whose name is dashed HALFWAY, and one that names nothing. The
; last two belong in the golden. Every silent contradiction the old two-parser arrangement
; produced is here: `--ocannl_log_level_0` was read and warned about (its separator is not an `=`,
; so the key came out as `log_level_0`), while the all-dashed and halfway-dashed spellings were
; warned about by nobody and read by nobody -- the halfway one is still not read, deliberately
; (see `Utils.cmdline_var_names`), and now says so. The bare `ocannl_config` is the argument that
; must draw NO warning however much it looks like one: a positional path belongs to the host
; application, which is why the qualified spellings all carry a leading dash.
;
; stderr alone is the subject; the executable's own stdout goes nowhere. Every key that shapes
; stderr is pinned on the commandline, which no environment variable can outrank -- the five of
; `startup_streams.ml`'s `stderr_shaping_keys` less `profile`, whose only route to this stream is
; through the four that are pinned (a profile cannot beat an explicit key of equal immediacy, and
; an unknown ambient profile name aborts every OCANNL executable loudly rather than rewriting a
; golden). Pinning the whole list, not just the reported `log_config_sourcing` (Codex P2 on PR
; #363): the rule captures a stream, so it depends on every key that can write to it.
;
; Since gh-ocannl-629 the environment writes to this stream too, which is why the rule sets three
; variables of its own: an `ocannl_config` file names the unknown key it holds and the commandline
; warns about an unknown argument, while a mistyped `OCANNL_...` used to be the one source that
; said nothing at all -- `OCANNL_BACKEDN=cuda dune runtest` ran the whole suite on the default
; backend and reported success. The two reserved namespaces are set as well, and their silence is
; as much of the policy as the warnings are: without them the walk would warn about `tools/`' own
; variables and about ppx_minidebug's per-module gates, on every OCANNL executable those workflows
; launch. What this rule no longer holds is a KNOWN key in an unread spelling, which since
; gh-ocannl-652 aborts the run: it has a rule of its own below, because a run that continues and a
; run that stops are two different claims.

(rule
 ; ocannl-backend: none -- classifies variable NAMES through Utils (env_var_name, classify_env_var);
 ; it never resolves the backend key's value, and links no backend to resolve it on.
 (target config_var_warnings.actual)
 (deps
  ocannl_config
  ; Every name below is one this rule SETS, so the deps are not what makes them arrive. What they
  ; make the rule notice is an ambient one arriving or leaving: since gh-ocannl-629 the environment
  ; writes to the stream this target captures, and an untracked variable would leave a stale golden
  ; passing. `ocannl_backedn` is tracked in both casings although only one is a spelling
  ; `Utils.env_var_name` would build: an ambient lowercase one is not read, but it IS reported, so
  ; it writes to this stream too.
  (env_var ocannl_backedn)
  (env_var OCANNL_BACKEDN)
  (env_var OCANNL_TOOL_SWEEP_STATE)
  (env_var OCANNL_LOG_LEVEL_ROW)
  ; The synthetic keys the executable looks up by name (gh-ocannl-749). It reads them through
  ; `Utils.read_env_var`, which no commandline flag outranks, and an ambient one draws the
  ; unknown-key warning onto the very stream this target captures -- so the run depends on them
  ; whether or not this rule sets them.
  (env_var OCANNL_DEMO_KEY)
  (env_var OCANNL_DASHED_ONLY_KEY))
 (action
  ; The environment half of the same claim (gh-ocannl-629): a name that is no key, and the two
  ; reserved namespaces whose silence is the other half of the policy -- the tooling's and
  ; ppx_minidebug's per-module gates, either of which would otherwise warn on every OCANNL
  ; executable a `tools/sweep.sh` run launches.
  (setenv
   OCANNL_BACKEDN
   cuda
   (setenv
    OCANNL_TOOL_SWEEP_STATE
    the-tooling-owns-this
    (setenv
     OCANNL_LOG_LEVEL_ROW
     9
     (with-stderr-to
      %{target}
      (ignore-stdout
       (run
        %{dep:config_var_spellings.exe}
        --ocannl_no_config_file=true
        --ocannl_suppress_welcome_message=true
        --ocannl_log_config_sourcing=false
        --ocannl_log_level=0
        --ocannl-print-decimals-precision-7
        --ocannl-print_decimals_precision=7
        --ocannl_log_level_0
        ocannl_config
        --ocannl-print_decimals-precision=7
        --ocannl-not-a-real-key=7))))))))

(rule
 (alias runtest-config_var_warnings)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff config_var_warnings.expected config_var_warnings.actual)))

; The third case, and the only one that is not a warning (gh-ocannl-652): a name that addresses a
; KNOWN configuration key in a spelling nothing reads. Somebody wrote `ocannl-log_level=1` to set a
; log level; continuing on the default would be the silent demotion this check exists to prevent,
; and is exactly what dropping a spelling people may have exported would otherwise inflict. So the
; run aborts, and the rule accepts the exit status that proves it did -- `(with-accepted-exit-codes
; 1)` rather than `ignore-exit-codes`, so that a build which stops for some OTHER reason still
; fails here instead of promoting whatever it managed to print.
;
; The DASHED spelling carries this leg, not a lowercase one: `ocannl_log_level` and
; `OCANNL_LOG_LEVEL` are one variable on Windows, where the lowercase form is therefore read and
; correctly draws nothing, while a dashed name is unread on every platform and this golden is the
; same everywhere.

(rule
 ; ocannl-backend: none -- classifies variable NAMES through Utils (env_var_name, classify_env_var);
 ; it never resolves the backend key's value, and links no backend to resolve it on.
 (target config_var_fatal_spelling.actual)
 (deps
  ocannl_config
  (env_var ocannl-log_level)
  ; As above: the executable reads these two by name, and an ambient one writes to the stream this
  ; target captures (gh-ocannl-749).
  (env_var OCANNL_DEMO_KEY)
  (env_var OCANNL_DASHED_ONLY_KEY))
 (action
  (setenv
   ocannl-log_level
   1
   (with-stderr-to
    %{target}
    (ignore-stdout
     (with-accepted-exit-codes
      1
      (run
       %{dep:config_var_spellings.exe}
       --ocannl_no_config_file=true
       --ocannl_suppress_welcome_message=true
       --ocannl_log_config_sourcing=false
       --ocannl_log_level=0)))))))

(rule
 (alias runtest-config_var_fatal_spelling)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff config_var_fatal_spelling.expected config_var_fatal_spelling.actual)))

