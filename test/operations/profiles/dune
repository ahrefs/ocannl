  (diff explicit_beats_profile.expected explicit_beats_profile.actual)))

; An EMPTY value is unset at each level independently, so a launcher expanding
; `--ocannl_profile=$PROFILE` with the variable unset must fall through to the environment and the
; config file rather than disabling the profile they name. Here the empty flag falls through to
; OCANNL_PROFILE, and the output is the env-picked one.

(rule
 ; ocannl-backend: none -- profile_precedence.exe links base, arrayjit.utils and stdio; the thirteen
 ; keys it exercises do not include `backend`, and no profile payload sets it.
 (target empty_cmdline_falls_through.actual)
 (deps
  ocannl_config
  (env_var OCANNL_AUTOTUNE_SEARCH)
  (env_var OCANNL_AUTOTUNE_ROUNDS)
  (env_var OCANNL_AUTOTUNE_BEAM_WIDTH)
  (env_var OCANNL_MODEL_DEFAULT_SCHEDULE)
  (env_var OCANNL_TUNE_INLINE_FLIPS)
  (env_var OCANNL_CC_BACKEND_ARCH_FLAGS)
  (env_var OCANNL_CC_BACKEND_SIMD_FLAGS)
  (env_var OCANNL_CC_BACKEND_FP_CONTRACT)
  (env_var OCANNL_CC_BACKEND_FAST_MATH)
  (env_var OCANNL_CC_VECTOR_BYTES)
  (env_var OCANNL_FP16_ARITHMETIC)
  (env_var OCANNL_TF32_MATMULS)
  (env_var OCANNL_VIRTUALIZE_MAX_VISITS)
  (env_var OCANNL_NO_CONFIG_FILE))
 (action
  (setenv
   OCANNL_PROFILE
   performance
   (with-stdout-to
    %{target}
    (run %{dep:profile_precedence.exe} --ocannl_profile=)))))

(rule
 (alias runtest-empty_cmdline_falls_through)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff
   empty_cmdline_falls_through.expected
   empty_cmdline_falls_through.actual)))
