; The ambient-environment gate (gh-ocannl-652). `(universe)` makes dune rerun it on every
; invocation, which is the only way a rejected environment spelling reaches a check at all:
; every other rule here is cached against declarations that no longer name those spellings,
; so `ocannl_backend=cuda dune build @test/operations/profiles/runtest` would otherwise serve this
; directory's previous run wholesale. One per test directory, because dune aliases are per
; directory; the source is shared, and its header says why the dependency is the world
; rather than 112 key names.

(copy_files
 (files ../../config/env_spelling_gate.ml))

(test
 ; ocannl-backend: none -- links arrayjit.utils alone and only classifies variable NAMES;
 ; its `(universe)` dependency reruns it whatever any variable is set to.
 (name env_spelling_gate)
 (package neural_nets_lib)
 (deps ocannl_config (universe))
 (modules env_spelling_gate)
 (libraries base stdio arrayjit.utils arrayjit.verdict))

; The same gate for the per-test `runtest-<name>` aliases (gh-ocannl-703, gh-ocannl-726). Every rule
; that diffs a golden sits on an alias of its own, so that ONE of them can be rerun targeted --
; `dune build @test/operations/profiles/runtest-from_config_file` -- and a per-test alias is a build
; entry point like any other, so the ambient gate has to reach it. It sits on an alias of its own
; that every such rule DEPENDS on, which runs the gate BEFORE the diff -- the same shape the slow
; rules use. The name is the one dune >= 3.20 generates for the `env_spelling_gate` `(test)` stanza
; above: a rule may add an action to a generated per-test alias, and this one runs the same gate
; binary, so the alias means the same thing whichever dune is building.

(rule
 ; ocannl-backend: none -- links arrayjit.utils alone and only classifies variable NAMES;
 ; its `(universe)` dependency reruns it whatever any variable is set to.
 (alias runtest-env_spelling_gate)
 (package neural_nets_lib)
 (deps ocannl_config (universe))
 (action
  (run %{dep:env_spelling_gate.exe})))

; This directory's golden-diff rules, aggregated back onto `runtest` (gh-ocannl-726). Each of them
; attaches to its own `runtest-<name>` alias and to NOTHING else, so that `dune build
; @test/operations/profiles/runtest-from_config_file` runs that one test and applies its diff; this
; stanza is what keeps `dune runtest` running all of them. Attaching such a rule to `runtest` as
; well would defeat the point: a rule on two aliases makes building either alias build both, so a
; per-test alias that also named `runtest` would pull the whole directory in behind it -- and where
; the name is one dune generates for a `(test)` stanza, dune rejects the pair outright as a
; dependency cycle. Hence the naming: `<name>` is the golden the rule checks, and never a `(test)`
; stanza's name in this directory. A `runtest-<name>` rule missing from this list is one plain `dune
; runtest` skips silently, which `test/operations/env_var_deps` checks -- the same check it makes of
; the `slow` suite.

(alias
 (name runtest)
 (deps
  (alias runtest-from_config_file)
  (alias runtest-from_cmdline)
  (alias runtest-from_cmdline_approximate)
  (alias runtest-from_env)
  (alias runtest-host_profile_flag)
  (alias runtest-explicit_beats_profile)
  (alias runtest-empty_cmdline_falls_through)))

; gh-ocannl-559: the same executable, resolved against four different pickers. The local
; ocannl_config (not the shared test/config one -- the config search stops at the first file
; walking up from the working directory) is deliberately "exhaustive": it picks a profile and
; also states three settings explicitly.

(executable
 (name profile_precedence)
 (modules profile_precedence)
 (libraries base arrayjit.utils stdio))

; An ambient profile variable would outrank this directory's config file and turn the file-picked
; rules into env-picked ones, so every rule clears `OCANNL_PROFILE` (an empty value counts as unset
; at every source). ONE clear per rule since gh-ocannl-652: the lowercase `ocannl_profile` used to
; be read FIRST -- it beat even the env-picked rule's own setting (Codex P2 on PR #291) -- and is
; now not read at all, and the dash-prefixed spellings were dropped in gh-ocannl-605, so there is
; nothing else to clear. For the other keys the executable itself refuses to run when one is set: a
; clear failure rather than a rewritten golden. That guard covers `no_config_file` too -- it cannot
; prevent its effect, that being read during Utils' initialization, but a rule that exits nonzero
; writes no golden. The startup chatter needs no guard: it goes to stderr (gh-ocannl-581) and these
; rules capture stdout only.
;
; The guard only RUNS when dune reruns the rule, and dune reruns for a variable the rule DECLARES --
; so every key it names is an `(env_var OCANNL_<KEY>)` below, on every rule, and
; `test/operations/env_var_deps` pairs the guard's keys with these declarations rather than trusting
; the two lists to agree (gh-ocannl-749). Without them dune served the previous run's golden across
; a change of the very variable the guard exists to report -- gh-ocannl-628's hole, reached from the
; guard side. `OCANNL_PROFILE` is not among them because each rule pins it with `setenv`, which no
; ambient value outranks: the honest option wherever it is available, a guard being the second best.

(rule
 ; ocannl-backend: none -- profile_precedence.exe links base, arrayjit.utils and stdio; the thirteen
 ; keys it exercises do not include `backend`, and no profile payload sets it.
 (target from_config_file.actual)
 (deps
  ocannl_config
  (env_var OCANNL_AUTOTUNE_SEARCH)
  (env_var OCANNL_AUTOTUNE_ROUNDS)
  (env_var OCANNL_AUTOTUNE_BEAM_WIDTH)
  (env_var OCANNL_MODEL_DEFAULT_SCHEDULE)
  (env_var OCANNL_TUNE_INLINE_FLIPS)
  (env_var OCANNL_CC_BACKEND_ARCH_FLAGS)
  (env_var OCANNL_CC_BACKEND_SIMD_FLAGS)
  (env_var OCANNL_CC_BACKEND_FP_CONTRACT)
  (env_var OCANNL_CC_BACKEND_FAST_MATH)
  (env_var OCANNL_CC_VECTOR_BYTES)
  (env_var OCANNL_FP16_ARITHMETIC)
  (env_var OCANNL_TF32_MATMULS)
  (env_var OCANNL_VIRTUALIZE_MAX_VISITS)
  (env_var OCANNL_NO_CONFIG_FILE))
 (action
  (setenv
   OCANNL_PROFILE
   ""
   (with-stdout-to
    %{target}
    (run %{dep:profile_precedence.exe})))))

(rule
 (alias runtest-from_config_file)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff from_config_file.expected from_config_file.actual)))

