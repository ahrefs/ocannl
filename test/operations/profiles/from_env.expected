profile                  = performance    (picked via the environment)
autotune_search          = true           (profile 'performance' via the environment)
autotune_rounds          = 4              (profile 'performance' via the environment)
autotune_beam_width      = 4              (profile 'performance' via the environment)
model_default_schedule   = true           (profile 'performance' via the environment)
tune_inline_flips        = 0              (default)
cc_backend_arch_flags    = auto           (profile 'performance' via the environment)
cc_backend_simd_flags    = auto           (profile 'performance' via the environment)
cc_backend_fp_contract   = auto           (default)
cc_backend_fast_math     = false          (default)
cc_vector_bytes          = 64             (config file)
fp16_arithmetic          = true           (profile 'performance' via the environment)
tf32_matmuls             = false          (default)
virtualize_max_visits    = 1              (default)
