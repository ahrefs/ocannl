profile                  = reproducible   (picked via the config file)
autotune_search          = false          (profile 'reproducible' via the config file)
autotune_rounds          = 7              (config file)
autotune_beam_width      = 2              (default)
model_default_schedule   = false          (profile 'reproducible' via the config file)
tune_inline_flips        = 0              (profile 'reproducible' via the config file)
cc_backend_arch_flags    = none           (profile 'reproducible' via the config file)
cc_backend_simd_flags    = none           (profile 'reproducible' via the config file)
cc_backend_fp_contract   = off            (profile 'reproducible' via the config file)
cc_backend_fast_math     = false          (profile 'reproducible' via the config file)
cc_vector_bytes          = 64             (config file)
fp16_arithmetic          = true           (config file)
tf32_matmuls             = false          (profile 'reproducible' via the config file)
virtualize_max_visits    = 1              (default)
