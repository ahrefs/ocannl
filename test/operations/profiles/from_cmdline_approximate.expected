profile                  = approximate    (picked via the commandline)
autotune_search          = true           (profile 'approximate' via the commandline)
autotune_rounds          = 4              (profile 'approximate' via the commandline)
autotune_beam_width      = 4              (profile 'approximate' via the commandline)
model_default_schedule   = true           (profile 'approximate' via the commandline)
tune_inline_flips        = 2              (profile 'approximate' via the commandline)
cc_backend_arch_flags    = auto           (profile 'approximate' via the commandline)
cc_backend_simd_flags    = auto           (profile 'approximate' via the commandline)
cc_backend_fp_contract   = fast           (profile 'approximate' via the commandline)
cc_backend_fast_math     = true           (profile 'approximate' via the commandline)
cc_vector_bytes          = 64             (config file)
fp16_arithmetic          = true           (profile 'approximate' via the commandline)
tf32_matmuls             = true           (profile 'approximate' via the commandline)
virtualize_max_visits    = 1              (default)
