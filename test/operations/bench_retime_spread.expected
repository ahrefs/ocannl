odd: ms=3.000000 ms_lo=1.000000 ms_hi=5.000000 ms_retimed=5/6
odd: the median is the middle admitted reading: true
odd: the range is the admitted extremes: true
odd: the refused call is counted apart: true
odd: the relative spread is (hi - lo) / median: true
