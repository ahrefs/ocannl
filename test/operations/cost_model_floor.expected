== pointwise map ==
  floor: flops=20 bytes=180 exact
  upper: flops=20 bytes=180
  floor <= upper: true
== matmul (rmw accumulator) ==
  floor: flops=240 bytes=376 exact
  upper: flops=240 bytes=376
  floor <= upper: true
== matmul, D's placement open ==
  floor: flops=0 bytes=0 inexact
  upper: flops=240 bytes=376
  floor <= upper: true
  commitment (narrowed open set) recovers the closed floor: true
  floors are monotone in refinement: true
== guarded write ==
  floor: flops=4 bytes=16 inexact
  upper: flops=8 bytes=32
  floor <= upper: true
== two disjoint reads, both extractions sum ==
  floor: flops=20 bytes=120 exact
  upper: flops=20 bytes=120
  floor <= upper: true
== two overlapping reads, union floor = larger image ==
  floor: flops=4 bytes=32 inexact
  upper: flops=4 bytes=48
  floor <= upper: true
== dynamic gather ==
  floor: flops=0 bytes=32 inexact
  upper: flops=0 bytes=64
  floor <= upper: true
== where short-circuit ==
  floor: flops=12 bytes=16 inexact
  upper: flops=20 bytes=48
  floor <= upper: true
== where arm hoisted into a scope body ==
  floor: flops=12 bytes=48 exact
  upper: flops=12 bytes=48
  floor <= upper: true
  hoisted arm: floor = upper on both legs, both exact: true
== over-producing closed ==
  floor: flops=8 bytes=72 exact
  upper: flops=8 bytes=72
  floor <= upper: true
== over-producing, P2's placement open ==
  floor: flops=0 bytes=4 inexact
  upper: flops=8 bytes=72
  floor <= upper: true
== and short-circuit ==
  floor: flops=8 bytes=32 inexact
  upper: flops=12 bytes=48
  floor <= upper: true
== arg1 discarded operand ==
  floor: flops=0 bytes=32 exact
  upper: flops=0 bytes=32
  floor <= upper: true
== relu-gate short-circuit ==
  floor: flops=4 bytes=32 inexact
  upper: flops=8 bytes=48
  floor <= upper: true
== dead loop ==
  floor: flops=0 bytes=0 inexact
  upper: flops=0 bytes=16
  floor <= upper: true

== operand conditionality ==
  fst                          Only_first
  snd                          Only_second
  add                          Both_operands
  sub                          Both_operands
  mul                          Both_operands
  div                          Both_operands
  pow                          Both_operands
  relu_gate                    Gated_second
  sat01_gate                   Gated_second
  max                          Both_operands
  min                          Both_operands
  mod_                         Both_operands
  lt                           Both_operands
  le                           Both_operands
  eq                           Both_operands
  ne                           Both_operands
  or_                          Gated_second
  and_                         Gated_second
  threefry4x32_crypto          Both_operands
  threefry4x32_light           Both_operands
  uint4x32_to_prec_uniform_lane Both_operands
  where                        Cond_and_one_arm
  fma                          All_three
  mul3                         All_three
  plain-C renderings agree: true
