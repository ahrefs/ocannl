== pointwise map ==
  floor: flops=20 bytes=180 exact
  upper: flops=20 bytes=180
  floor <= upper: true
== matmul (rmw accumulator) ==
  floor: flops=240 bytes=296 inexact
  upper: flops=240 bytes=376
  floor <= upper: true
== matmul, D's placement open ==
  floor: flops=0 bytes=0 inexact
  upper: flops=240 bytes=376
  floor <= upper: true
  commitment (narrowed open set) recovers the closed floor: true
  floors are monotone in refinement: true
== guarded write ==
  floor: flops=4 bytes=16 inexact
  upper: flops=8 bytes=32
  floor <= upper: true
== two disjoint reads, both extractions sum ==
  floor: flops=20 bytes=120 exact
  upper: flops=20 bytes=120
  floor <= upper: true
== two overlapping reads, union floor = larger image ==
  floor: flops=4 bytes=32 inexact
  upper: flops=4 bytes=48
  floor <= upper: true
== dynamic gather ==
  floor: flops=0 bytes=36 inexact
  upper: flops=0 bytes=48
  floor <= upper: true
== where short-circuit ==
  floor: flops=12 bytes=16 inexact
  upper: flops=20 bytes=48
  floor <= upper: true
== where arm hoisted into a scope body ==
  floor: flops=12 bytes=48 exact
  upper: flops=12 bytes=48
  floor <= upper: true
  hoisted arm: floor = upper on both legs, both exact: true
== over-producing closed ==
  floor: flops=8 bytes=72 exact
  upper: flops=8 bytes=72
  floor <= upper: true
== over-producing, P2's placement open ==
  floor: flops=0 bytes=4 inexact
  upper: flops=8 bytes=72
  floor <= upper: true
== and short-circuit ==
  floor: flops=8 bytes=32 inexact
  upper: flops=12 bytes=48
  floor <= upper: true
== arg1 discarded operand ==
  floor: flops=0 bytes=32 exact
  upper: flops=0 bytes=32
  floor <= upper: true
== relu-gate short-circuit ==
  floor: flops=4 bytes=32 inexact
  upper: flops=8 bytes=48
  floor <= upper: true
== dead loop ==
  floor: flops=0 bytes=0 inexact
  upper: flops=0 bytes=16
  floor <= upper: true

== image lower bound vs enumerated image ==
  1 coord, 2 terms     1024 cases,  940 bounded exactly
  1 coord, 3 terms     2048 cases, 1440 bounded exactly
  cancelling terms        3 cases,    3 bounded exactly
  dynamic gather        400 cases,  266 bounded exactly
  flattened Sub_axis    200 cases,  181 bounded exactly
  random map            600 cases,  559 bounded exactly
  vector run            200 cases,    0 bounded exactly
  the bound never exceeds the enumerated image: true
  a unit-stride window counts O + K - 1 (8 + 3 - 1): true
  a stride-2 window counts 2*(O-1) + K (2*7 + 3): true
  a non-overlapping stride-4 window counts O*K (8*3): true
  2*x + 4*y over 3x3 counts its 7 values (the gcd normalization): true
== window read, stride 1, O=8, K=3 ==
  floor: flops=24 bytes=72 inexact
  upper: flops=24 bytes=104
  floor <= upper: true
  the unit-stride window's input read floors at its whole image: true
== window read, stride 2, O=8, K=3 ==
  floor: flops=24 bytes=100 inexact
  upper: flops=24 bytes=132
  floor <= upper: true
  the stride-2 window's input read floors at its whole image: true

== operand conditionality ==
  fst                          Only_first
  snd                          Only_second
  add                          Both_operands
  sub                          Both_operands
  mul                          Both_operands
  div                          Both_operands
  pow                          Both_operands
  relu_gate                    Gated_second
  sat01_gate                   Gated_second
  max                          Both_operands
  min                          Both_operands
  mod_                         Both_operands
  lt                           Both_operands
  le                           Both_operands
  eq                           Both_operands
  ne                           Both_operands
  or_                          Gated_second
  and_                         Gated_second
  threefry4x32_crypto          Both_operands
  threefry4x32_light           Both_operands
  uint4x32_to_prec_uniform_lane Both_operands
  where                        Cond_and_one_arm
  fma                          All_three
  mul3                         All_three
  plain-C renderings agree: true
