; The ambient-environment gate (gh-ocannl-652). `(universe)` makes dune rerun it on every
; invocation, which is the only way a rejected environment spelling reaches a check at all:
; every other rule here is cached against declarations that no longer name those spellings,
; so `ocannl_backend=cuda dune build @test/operations/startup_streams/runtest` would
; otherwise serve this directory's previous run wholesale. One per test directory, because dune aliases are per
; directory; the source is shared, and its header says why the dependency is the world
; rather than 112 key names.

(copy_files
 (files ../../config/env_spelling_gate.ml))

(test
 ; ocannl-backend: none -- links arrayjit.utils alone and only classifies variable NAMES;
 ; its `(universe)` dependency reruns it whatever any variable is set to.
 (name env_spelling_gate)
 (package neural_nets_lib)
 (deps ocannl_config (universe))
 (modules env_spelling_gate)
 (libraries base stdio arrayjit.utils arrayjit.verdict))

; The same gate for the per-test `runtest-<name>` aliases (gh-ocannl-703, gh-ocannl-726). Every rule
; that diffs a golden sits on an alias of its own, so that ONE of them can be rerun targeted --
; `dune build @test/operations/startup_streams/runtest-stdout_clean` -- and a per-test alias is a
; build entry point like any other, so the ambient gate has to reach it. It sits on an alias of its
; own that every such rule DEPENDS on, which runs the gate BEFORE the diff -- the same shape the
; slow rules use. The name is the one dune >= 3.20 generates for the `env_spelling_gate` `(test)`
; stanza above: a rule may add an action to a generated per-test alias, and this one runs the same
; gate binary, so the alias means the same thing whichever dune is building.

(rule
 ; ocannl-backend: none -- links arrayjit.utils alone and only classifies variable NAMES;
 ; its `(universe)` dependency reruns it whatever any variable is set to.
 (alias runtest-env_spelling_gate)
 (package neural_nets_lib)
 (deps ocannl_config (universe))
 (action
  (run %{dep:env_spelling_gate.exe})))

; This directory's golden-diff rules, aggregated back onto `runtest` (gh-ocannl-726). Each of them
; attaches to its own `runtest-<name>` alias and to NOTHING else, so that `dune build
; @test/operations/startup_streams/runtest-stdout_clean` runs that one test and applies its diff;
; this stanza is what keeps `dune runtest` running all of them. Attaching such a rule to `runtest`
; as well would defeat the point: a rule on two aliases makes building either alias build both, so a
; per-test alias that also named `runtest` would pull the whole directory in behind it -- and where
; the name is one dune generates for a `(test)` stanza, dune rejects the pair outright as a
; dependency cycle. Hence the naming: `<name>` is the golden the rule checks, and never a `(test)`
; stanza's name in this directory. A `runtest-<name>` rule missing from this list is one plain `dune
; runtest` skips silently, which `test/operations/env_var_deps` checks -- the same check it makes of
; the `slow` suite.

(alias
 (name runtest)
 (deps
  (alias runtest-stdout_clean)
  (alias runtest-default_stderr)
  (alias runtest-bootstrap_precedence)))

; gh-ocannl-593 / gh-ocannl-595: the two streams an OCANNL-linked executable writes at startup.
; The local ocannl_config (not the shared test/config one -- the config search stops at the first
; file walking up from the working directory) is deliberately a DEFAULT configuration carrying an
; unknown key; see the comments there and in startup_streams.ml.

(executable
 (name startup_streams)
 (modules startup_streams)
 (libraries base arrayjit.utils arrayjit.verdict stdio bench_args))

; The stdout half, with the chatter turned all the way UP: `no_config_file` picks the
; "Configuration defaults file is disabled" welcome arm, and the sourcing trace reports every key
; the library reads. `with-stdout-to` captures stdout ALONE, which is exactly the discrimination
; the test needs -- the golden is empty, and it is the whole assertion. The dep on ocannl_config
; is what config_dep_completeness asks of a rule that runs an executable; this rule disables the
; file rather than reading it, and depending on it anyway keeps the two claims independent.
;
; The env_var deps are the guard's keys, declared on EVERY rule that runs this executable and not on
; the guarding one alone (gh-ocannl-749, Codex P1). This rule's claim is stream-level and does hold
; under any of them -- but dune invalidates each rule on its own deps, so a check that let a
; neighbour's declaration answer for this run could not tell that case apart from a rule that had
; dropped a key. Three of the five are pinned on the commandline below besides, which the ambient
; environment cannot outrank; the declaration costs a rerun and says so where the next author reads.

(rule
 ; ocannl-backend: none -- startup_streams.exe links no backend; the claim is about which stream
 ; the startup banner and the unknown-key warning go to, neither of which names a backend.
 (target stdout_clean.actual)
 (deps
  ocannl_config
  (env_var OCANNL_SUPPRESS_WELCOME_MESSAGE)
  (env_var OCANNL_LOG_CONFIG_SOURCING)
  (env_var OCANNL_LOG_LEVEL)
  (env_var OCANNL_NO_CONFIG_FILE)
  (env_var OCANNL_PROFILE))
 (action
  (with-stdout-to
   %{target}
   (run
    %{dep:startup_streams.exe}
    --ocannl_no_config_file=true
    --ocannl_log_config_sourcing=true
    --ocannl_log_level=1))))

(rule
 (alias runtest-stdout_clean)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff stdout_clean.expected stdout_clean.actual)))

; The stderr half, on a default run: the subject writes nothing itself, so the golden is the
; library's entire startup output -- and the point is that a warning is legible in it. The second
; process is the same executable in its normalizer mode, stripping the build directory from the
; config file's absolute path; it is given a silent configuration of its own so that the build log
; does not carry a copy of the chatter under test.
;
; The env_var deps are what make the executable's own guard reachable: dune tracks no environment
; variable but OCANNL_BACKEND, so an ambient OCANNL setting arriving after this target was built
; would otherwise leave the stale .raw in place and the test green without having run (Codex P2 on
; PR #348). Declaring them makes the change invalidate the rule, the guard fire, and the run fail
; by name. Both spellings of each, as `Utils.env_var_names` builds them: the `ocannl_`-prefixed key
; in lowercase and in uppercase, which since gh-ocannl-605 is all an OCANNL setting has in the
; environment (dashes remain a commandline affordance). The keys are the ones that shape stderr --
; what the guard checks, less `clean_up_*`, which are pinned on the commandline below and so cannot
; be reached from the environment.

(rule
 ; ocannl-backend: none -- startup_streams.exe links no backend; the claim is about which stream
 ; the startup banner and the unknown-key warning go to, neither of which names a backend.
 (target default_stderr.raw)
 (deps
  ocannl_config
  (env_var OCANNL_SUPPRESS_WELCOME_MESSAGE)
  (env_var OCANNL_LOG_CONFIG_SOURCING)
  (env_var OCANNL_LOG_LEVEL)
  (env_var OCANNL_NO_CONFIG_FILE)
  (env_var OCANNL_PROFILE))
 (action
  (with-stderr-to
   %{target}
   (run
    %{dep:startup_streams.exe}
    guard
    --ocannl_clean_up_build_files_on_startup=false
    --ocannl_clean_up_log_files_on_startup=false))))

(rule
 ; ocannl-backend: none -- startup_streams.exe links no backend; the claim is about which stream
 ; the startup banner and the unknown-key warning go to, neither of which names a backend.
 (target default_stderr.actual)
 (deps
  ocannl_config
  (env_var OCANNL_SUPPRESS_WELCOME_MESSAGE)
  (env_var OCANNL_LOG_CONFIG_SOURCING)
  (env_var OCANNL_LOG_LEVEL)
  (env_var OCANNL_NO_CONFIG_FILE)
  (env_var OCANNL_PROFILE))
 (action
  (with-stdin-from
   %{dep:default_stderr.raw}
   (with-stdout-to
    %{target}
    (run
     %{dep:startup_streams.exe}
     normalize
     --ocannl_no_config_file=true
     --ocannl_suppress_welcome_message=true)))))

(rule
 (alias runtest-default_stderr)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff default_stderr.expected default_stderr.actual)))

; gh-ocannl-604: conflicting file values cannot override explicit commandline bootstrap keys.

(rule
 ; ocannl-backend: none -- startup bootstrap decisions and sourcing trace only.
 (target bootstrap_precedence.raw)
 (deps
  ocannl_config
  bootstrap_conflict/ocannl_config
  (env_var OCANNL_SUPPRESS_WELCOME_MESSAGE)
  (env_var OCANNL_LOG_CONFIG_SOURCING)
  (env_var OCANNL_LOG_LEVEL)
  (env_var OCANNL_NO_CONFIG_FILE)
  (env_var OCANNL_PROFILE))
 (action
  (with-stderr-to
   %{target}
   (chdir
    bootstrap_conflict
    (run
     %{dep:startup_streams.exe}
     --ocannl_no_config_file=false
     --ocannl_suppress_welcome_message=false
     --ocannl_log_config_sourcing=true
     --ocannl_log_level=0
     "--ocannl_profile= RePROducible ")))))

(rule
 ; ocannl-backend: none -- validates the captured startup trace, no backend linked.
 (target bootstrap_precedence.actual)
 (deps
  ocannl_config
  (env_var OCANNL_SUPPRESS_WELCOME_MESSAGE)
  (env_var OCANNL_LOG_CONFIG_SOURCING)
  (env_var OCANNL_LOG_LEVEL)
  (env_var OCANNL_NO_CONFIG_FILE)
  (env_var OCANNL_PROFILE))
 (action
  (with-stdin-from
   %{dep:bootstrap_precedence.raw}
   (with-stdout-to
    %{target}
    (run
     %{dep:startup_streams.exe}
     bootstrap-check
     --ocannl_no_config_file=true
     --ocannl_suppress_welcome_message=true
     --ocannl_log_config_sourcing=false
     --ocannl_log_level=0
     --ocannl_profile=reproducible)))))

(rule
 (alias runtest-bootstrap_precedence)
 (package neural_nets_lib)
 (deps
  (alias runtest-env_spelling_gate))
 (action
  (diff bootstrap_precedence.expected bootstrap_precedence.actual)))
