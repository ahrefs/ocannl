tensor/shape.ml: row_numbered_refs (ref) -- accounted: every write noted or at a boundary; captured by capture_globals
tensor/shape.ml: update_uid (ref) -- exempt: a fresh-id counter: ids are never reused, so a rewind need not restore it
tensor/shape.ml: with_error_trace (ref) -- accounted; kept by rewinds: user configuration of error messages, not inference state
tensor/shape.ml: unused_shapes (ref) -- accounted: every write noted or at a boundary; captured by capture_globals
tensor/shape.ml: state (ref) -- fingerprinted by mutated_since; captured by capture_globals
tensor/shape.ml: construction_depth (ref) -- exempt: the construction window's depth, restored by the window's own finally
tensor/shape.ml: active_update_steps (ref) -- fingerprinted by mutated_since; captured by capture_globals
tensor/shape.ml: active_constraints (ref) -- fingerprinted by mutated_since; captured by capture_globals
tensor/shape.ml: active_instances (ref) -- fingerprinted by mutated_since; captured by capture_globals
tensor/shape.ml: tracing (ref) -- exempt: the shape-scheme traces in progress, restored by the trace's own finally
tensor/shape.ml: taint (ref) -- exempt: the taint itself: a record of the first failure, not inference state
tensor/shape.ml: discarded_updates (ref) -- accounted; kept by rewinds: a registry of what rewinds discarded: rewinds extend it, never restore it
tensor/shape.ml: on_closure (ref) -- exempt: a hook Tensor installs once at module initialization, not inference state
tensor/shape.ml: closure_count (ref) -- exempt: a count of commits, which only ends checkpoints: never restored
tensor/shape.ml: checkpoint_lineage (ref) -- exempt: the lineage of valid checkpoints: bookkeeping of checkpoints, not inference state
tensor/shape.ml: checkpoint_seq (ref) -- exempt: a fresh-id counter: ids are never reused, so a rewind need not restore it
tensor/shape.ml: failed_reads (ref) -- exempt: a record of reads that raised, consulted by a rewind's validity check: never restored
tensor/shape.ml: counts (ref) -- exempt: registration statistics, not inference state
tensor/shape.ml: times (ref) -- exempt: registration timings, not inference state
tensor/shape.ml: timing_paused (ref) -- exempt: registration timings, not inference state
tensor/shape.ml: live (unread state) -- exempt
tensor/shape.ml: boundary add_discarded_updates -- part of a rewind: it records the discarded update range, which no rewind restores
tensor/shape.ml: boundary restore_globals -- part of a rewind: puts back the globals a checkpoint captured
tensor/shape.ml: boundary rewind -- the rewind: it restores the checkpoint and clears the taint
tensor/shape.ml: boundary unsafe_reinitialize -- the session reset: it discards all state and clears the taint
tensor/shape.ml: boundary finish_inference_body -- the commit point: finish_inference taints the session on any failure of this body
