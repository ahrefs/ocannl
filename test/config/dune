; The shared test-configuration directory: the `ocannl_config` every test directory copies, the
; ambient `env_spelling_gate.ml` source they each build a gate from, and the resolved-configuration
; files a per-backend golden names, produced HERE rather than once per consuming directory.
;
; The `ocannl_read_config` executable resolves a configuration key exactly the way a test run will:
; the config file beside it, the environment, the command line. It lives here rather than beside a
; consumer because any test directory can need it -- `test/operations` reads the emitted-code
; extension in its codegen rules and the resolved backend name in its `micrograd_demo_logging` log
; goldens; tools/batch-backends.sh asks it which backend a tools/test-run.sh batch holds, for the
; batch's dune width and fleet slot -- and a copy per consumer is a second resolution to keep in
; step. Its `(public_name)` is what makes `%{bin:ocannl_read_config}` resolve from anywhere in the
; workspace.

(executable
 (name ocannl_read_config)
 (package neural_nets_lib)
 (public_name ocannl_read_config)
 (modules ocannl_read_config)
 (libraries base arrayjit.utils))

; The reachability half of a batch's backends (gh-ocannl-1004, gh-ocannl-1066): which backends the
; stanzas a dune argv can run NAME, which no configuration value shows. tools/batch-backends.sh
; builds it beside `ocannl_read_config` and runs it from the repository root; the reasoning is
; Test_utils.Slot_kind's, which reads the same backend markers `env_var_deps` enforces.

(executable
 (name ocannl_slot_kind)
 (modules ocannl_slot_kind)
 (libraries base stdio test_utils))

; The resolved backend name and the extension its backend emits code under, as files any directory
; can read: `"<name>-%{read:../config/ocannl_backend.txt}.expected"` names a per-backend golden and
; `%{read:../config/ocannl_backend_extension.txt}` names an emitted-code artifact, with nothing to
; copy and no second rule to keep in step. Dune builds a target rule on demand, so a directory that
; reads neither file runs neither rule.
;
; One resolution for the whole suite is not an approximation: every test directory copies THIS
; directory's `ocannl_config`, and the environment and command line are the same world for all of
; them, so a per-directory rule could only ever produce the same answer.
;
; `(env_var OCANNL_BACKEND)` is what makes `OCANNL_BACKEND=cuda dune build @…` re-resolve rather
; than serve the previous backend's answer -- and it is what `test/operations/env_var_deps` requires
; of a stanza that runs an executable whose behaviour the variable selects.

(rule
 (target ocannl_backend.txt)
 (package neural_nets_lib)
 (deps
  ocannl_config
  ocannl_ambient
  (env_var OCANNL_BACKEND))
 (action
  (run %{bin:ocannl_read_config} "--read=backend")))

(rule
 (target ocannl_backend_extension.txt)
 (package neural_nets_lib)
 (deps
  ocannl_config
  ocannl_ambient
  (env_var OCANNL_BACKEND))
 (action
  (run %{bin:ocannl_read_config} "--read=backend_extension")))

; gh-ocannl-1149: the environment as a dependency. `ocannl_ambient` records the ambient
; `OCANNL_*` environment addressed to the configuration (the program's header says which part and
; why); `(universe)` reruns it on every invocation, and dune's early cutoff stops at its output while
; that is unchanged. `ambient/ocannl_config` is the shared configuration with that record appended
; as comments: it is what every test directory copies, so every rule depending on its
; `ocannl_config` -- which `config_dep_completeness` asks of every rule running a program that reads
; one -- reruns when the environment changes, with no `(env_var …)` naming a key. A directory that
; checks in a configuration of its own depends on `ocannl_ambient` beside it instead.
;
; No `(package …)`: arrayjit/test copies `ocannl_ambient` too, and must find it under
; `dune build -p arrayjit`. The command-line pins keep the reader quiet on stderr whatever the
; environment says -- they outrank it for the run without changing what the environment holds. The
; program writes its target itself rather than through `with-stdout-to`: an ambient tracing setting
; can make `Utils` print to stdout, which must not land in every test's configuration.

(executable
 (name ocannl_ambient_env)
 (modules ocannl_ambient_env)
 (libraries base stdio unix arrayjit.utils))

; gh-ocannl-1038: the host as a dependency, beside the environment. A test whose verdict reads a
; capability a backend probes on the host -- the rocWMMA header tree the HIP backend's tile-MMA
; support requires, the OpenMP runtime the cc backend's parallel Grid loops link against, the
; vector width its SIMD probes find -- read something no rule named: a tree appearing at a path
; already searched changed no declared input, and dune served the verdict computed without it.
; `ocannl_host_capabilities` is `Context.host_capabilities`, the backends' own probes collected
; without opening a device, written by tools/host_caps.exe -- the program that prints the same
; capabilities as every CI build job's host line -- under `(universe)`, so once per invocation:
; about a quarter second, the cc probes' compiles, which the invocation's tests then find in the
; probe cache under the temporary directory dune gives it. The ambient record appends it, so a
; moved capability reruns every rule `config_dep_completeness` already requires to depend on the
; record, with nothing declared per stanza. Its stdout is the CI line and is dropped here.

(rule
 ; ocannl-backend: none -- probes the host through every backend's device-free probes and selects no
 ; backend; it opens no device.
 (target ocannl_host_capabilities)
 (deps ocannl_config (universe))
 (action
  (ignore-stdout
   (run
    %{exe:../../tools/host_caps.exe}
    --record=%{target}
    --ocannl_suppress_welcome_message=true
    --ocannl_log_config_sourcing=false))))

(rule
 ; ocannl-backend: none -- links arrayjit.utils alone; reads the environment and the host record.
 (target ocannl_ambient)
 (deps ocannl_config (universe))
 (action
  (run
   %{exe:ocannl_ambient_env.exe}
   --host-record=%{dep:ocannl_host_capabilities}
   --ocannl_suppress_welcome_message=true
   --ocannl_log_config_sourcing=false)))

(subdir
 ambient
 (rule
  (target ocannl_config)
  (deps ../ocannl_config ../ocannl_ambient)
  (action
   (with-stdout-to
    %{target}
    (progn
     (cat ../ocannl_config)
     (cat ../ocannl_ambient))))))
