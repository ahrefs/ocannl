suppress_welcome_message=true
log_config_sourcing=false
log_main_domain_to_stdout=true
backend=cc
log_level=0
print_decimals_precision=2
prefer_backend_uniformity=true
default_prec=single
fixed_state_for_init=42
strict_failure_classification=true
# Don't delete files as tests might be running in parallel deleting each-other's files.
clean_up_build_files_on_startup=false
clean_up_log_files_on_startup=false
output_debug_files_in_build_directory=false
# gh-ocannl-1899: suite-wide, a missing owner edge fails its consume_forward_code.
debug_check_forward_root_owners=true
# gh-ocannl-1859: suite-wide, a read of a variable a closure retired fails.
debug_check_retired_solver_vars=true
# gh-ocannl-1873: suite-wide, a routine's fresh written-first outputs start from NaN.
debug_fill_fresh_outputs=true
