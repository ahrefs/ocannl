# This file lists all the current configurations. It can be used as documentation
# or as a template for writing `ocannl_config` files. The `ocannl_` prefix is optional
# everywhere: commandline arguments accept both `--ocannl_<name>=<value>` and
# `--<name>=<value>`; environment variables still require the prefix (to avoid
# conflicts with other tools) and are spelled `OCANNL_<NAME>`, uppercase, that one
# and nothing else; in `ocannl_config` files the prefix has always been
# optional. Commandline arguments additionally accept dashes in place of underscores,
# as two independent choices: the prefix separator on its own, and the name's own
# separators all together -- `--ocannl_log_level=1`, `--ocannl-log_level=1`,
# `--ocannl_log-level=1` and `--ocannl-log-level=1` are the same setting, a halfway
# dashed name is not a spelling and is reported as an unknown argument. A single
# leading dash works too, as does `_` or `-` in place of the `=`; a leading dash is
# required though -- a bare `ocannl_log_level=1` is a positional argument of the host
# application, and OCANNL leaves it alone. In `ocannl_config` files the names are
# case-insensitive. The values are case-sensitive and should be
# lowercase where case is irrelevant. The configuration is read from a few sources,
# from highest priority:
# 1. Commandline arguments.
#    1a. The payload of a `profile` picked by a commandline argument.
# 2. Environment variables.
#    2a. The payload of a `profile` picked by an environment variable.
# 3. `ocannl_config` files.
#    3a. The payload of a `profile` picked by the `ocannl_config` file.
# 4. Defaults hard-coded at use sites in the source code.
#
# Each source level splits into two sublevels because a profile is an aggregate setting:
# it applies at the sublevel just below the explicit keys of whichever source picked it
# (see `profile` below). So a specific key always beats a profile of equal immediacy
# (`--ocannl_profile=reproducible --ocannl_autotune_rounds=3` gets the profile except for
# that one key), while a profile named on the commandline still overrides an exhaustive
# config file.
#
# Only one `ocannl_config` file is used per run, searched for in the current directory
# and in ancestor directories. Set `log_config_sourcing` to see where each setting a run
# reads comes from. This startup chatter -- the welcome message included -- goes to
# stderr, so an OCANNL-linked executable's stdout stays a clean data channel; stderr in
# turn stays quiet by default, so that a warning -- e.g. about an unknown config key --
# is legible when it appears.
#
# Every setting below is COMMENTED OUT and its value is (one of) the defaults, so that
# this file can be copied wholesale to an `ocannl_config` without thereby stating a
# hundred explicit settings that were never chosen (which would, among other things,
# leave a profile mostly inert). Uncomment the lines you mean.
#
# Repeating fields are disallowed. If the value is an empty string, the default value
# is used (as if the config was not present).

# A mistake is reported by every source, and by name: an unknown key in an `ocannl_config`
# file draws `OCANNL warning: unknown config key "..." in <file>` and the run continues on
# the defaults, an `--ocannl_`-prefixed commandline argument no key would read draws a
# warning, and so does an `ocannl_`-prefixed environment variable that names no key.
# One mistake is FATAL rather than warned about: an environment variable that names a
# KNOWN key in a spelling nothing reads -- `ocannl_backend=cuda`, `ocannl-log_level=1`,
# `OCANNL_PRINT-DECIMALS-PRECISION=7` (dashes separate a key on the commandline, never here) --
# since a value written to decide something would otherwise be dropped in silence and the
# run would proceed on the default. The message names the spelling that works, and the fix
# is to write that: uppercase the name, and replace any dash inside the key with an
# underscore -- `OCANNL_PRINT-DECIMALS-PRECISION` becomes `OCANNL_PRINT_DECIMALS_PRECISION`,
# not merely an uppercased form of itself. (Windows environment names are case-insensitive,
# so there `ocannl_backend` IS `OCANNL_BACKEND` and is read; a dashed name is unread on every
# platform, case-insensitivity being about case and not punctuation.) An empty value counts
# as unset everywhere and is never reported. Only a built-in profile's payload is otherwise
# fatal about an unknown key, that being this file's own mistake rather than yours. Two
# environment namespaces are reserved for names that address OCANNL without being
# configuration, and are never reported: `OCANNL_TOOL_...`, which this repository's scripts
# and test harnesses use (`OCANNL_TOOL_SWEEP_STATE`, `OCANNL_TOOL_TEST_CAP`), and
# `OCANNL_LOG_LEVEL_<MODULE>`, the per-module tracing gates that ppx_minidebug reads at
# preprocessing time. Anything else set under the prefix is taken to be addressed here.

# Bootstrap configurations (read before the config file search begins):

# If true, suppresses the "Welcome to OCANNL!" startup message (printed to stderr).
#suppress_welcome_message=false

# If true, disables reading any ocannl_config file; only commandline and environment
# variable configuration is used.
#no_config_file=false

# If true, prints to stderr where each setting a run reads comes from (commandline,
# environment, config file, or the hard-coded default). Off by default: the trace runs to
# some eighty lines on a run that reads a config file, and it would bury the warnings that
# share stderr with it. Enable it (also for a single run, via
# `--ocannl_log_config_sourcing=true`) to debug which configuration a run actually picks up.
#log_config_sourcing=false

# A goal-oriented preset bundle. Three are built in:
#   reproducible -- deterministic, and identical across machines wherever reasonable
#                   (cross-BACKEND reproducibility is out of scope).
#   performance  -- the fastest configuration AT UNCHANGED SEMANTICS.
#   approximate  -- the fastest configuration at tolerance-bounded semantics: the
#                   `performance` payload plus every numerics-changing knob (tf32_matmuls,
#                   fp16_arithmetic, cc_backend_fast_math, cc_backend_fp_contract,
#                   tune_inline_flips, and the algebraic-rewrite gates as they land).
#                   Results differ from the exact profiles by the tolerance the benchmark
#                   parity envelope names (`PARITY_TOL_APPROX` in benchmarks/orchestrate.py),
#                   never in shape or in which operations run (gh-ocannl-719). The knobs it
#                   flips are already part of the schedule cache's identity (the numerics
#                   and codegen digests below), so a default-flags run never replays a
#                   winner tuned under this profile; a rewrite gate joining the payload
#                   joins the numerics digest in the same PR.
# Unset (the default) means no profile: every setting resolves as it always has. Empty counts
# as unset at each level independently, so `--ocannl_profile=` (a launcher expanding an unset
# variable) falls through to `OCANNL_PROFILE` and to the config file rather than disabling the
# profile they name.
#
# A profile's payload is literally a partial config file (the verbatim texts are
# reproduced at the end of this file); it sets only the keys where the goals disagree,
# and everything it does not mention keeps its ordinary resolution. The payload applies at
# the sublevel just below the explicit keys of the source that PICKED the profile: a
# profile picked by `--ocannl_profile=...` outranks explicit config-file keys, while
# within one config file the explicit keys outrank a `profile=...` line of that same file.
# With `log_config_sourcing`, each payload-derived value is reported with its provenance,
# e.g. `Found false, in the profile "reproducible" picked via the commandline`.
#
# The bootstrap keys above (`suppress_welcome_message`, `no_config_file`,
# `log_config_sourcing`) and `profile` itself are resolved before profiles are, so a
# payload cannot set them.
#
# This is the one key whose commandline form must carry the `ocannl_` prefix:
# `--ocannl_profile=...`, not `--profile=...`. OCANNL scans the host executable's whole
# commandline, `--profile` is a common application option, and an unknown profile name is
# fatal -- so claiming the prefix-free spelling would kill host programs that have their
# own. The environment (`OCANNL_PROFILE`) and the config file are unaffected.
#
# Note the documented dune-caching trap: changing `OCANNL_PROFILE` does not retrigger
# tests (only `OCANNL_BACKEND` is an explicit dune dependency), so pick profiles for a
# test run in `test/config/ocannl_config` instead.
#profile=

# Configurations that are stored as `Utils.settings`:

# The log level, for ppx_minidebug and with a few other uses in OCANNL. 0 (the default) is
# quiet; 1 adds e.g. backend info to printed tensor headers; the settings that make the
# generated code itself verbose require 2 (see the two entries below).
#log_level=0

# If `log_level` is at least 2 and this is true, the generated code will contain
# printf statements, whose output is then (typically) integrated into ppx_minidebug logs.
#debug_log_from_routines=false

# If true, various intermediate representation files for the compiled code are generated
# (or not removed). Moreover, if log level is at least 2, the generated binaries will
# contain debug symbols for debugging with `gdb`, `cuda-gdb` etc.
#output_debug_files_in_build_directory=false

# If true, when printing Low_level.t values in human-readable syntax (.ll files),
# tensor node names will include their precision annotations (e.g., `n3<single>` instead of `n3`).
# This is useful for debugging precision-related issues in generated code.
#output_prec_in_ll_files=false

# If given, the integer seed to initialize the randomness library with.
#fixed_state_for_init=

# For printing tensors, etc.
#print_decimals_precision=2

# Complains if a half-precision tensor node is a constant with absolute value exceeding this.
#check_half_prec_constants_cutoff=16384.0

# The default variant of threefry4x32 PRNG to use. Options: "crypto" (20 rounds) or
# "light" (2 rounds). Defaults to "light" for better performance.
#default_prng_variant=light

# If true, use int64 for indexing arithmetic. If false (default), use int32 for indexing arithmetic
# (signed since docs/proposals/signed-index-precision.md; unsigned precisions remain for data
# domains). This affects all backends' kernel index parameters and local index variables, and the
# Metal pool offset width (which stays unsigned: uint vs ulong). Set to true for models with
# tensors/pools larger than 2^31 elements / 2^32 bytes; with the default, each tensor node's padded
# element count must fit int32 (enforced with an error when the node's dimensions are resolved).
#large_models=false

# Deprecated alias for large_models (its pre-gh-ocannl-344 name): read as a fallback only when
# large_models is unset, so existing configs / CLI / OCANNL_BIG_MODELS keep working.
#big_models=false

# Generated code files are placed in build_files/<prefix>/, and diagnostic / routine-debug
# logs in log_files/<prefix>/. When unset (the default), the prefix is derived from the
# executable's base name, so concurrently running programs sharing a working directory
# (e.g. parallel dune tests) never collide on same-named kernels. Set to a non-empty value
# to pick the subdirectory explicitly, or to the special value "." for the flat legacy
# layout (files directly in build_files/ and log_files/).
#build_files_prefix=

# If true, the build_files/<prefix>/ subdirectory of this process (see build_files_prefix)
# is deleted on startup; the whole build_files/ directory when the prefix is ".".
#clean_up_build_files_on_startup=true

# If true, the log_files/<prefix>/ subdirectory of this process (see build_files_prefix)
# is deleted on startup; the whole log_files/ directory when the prefix is ".".
#clean_up_log_files_on_startup=true

# Other configurations:

# The default backend for computations, if `Backends.fresh_backend` isn't passed `backend_name`.
# Available: cc, multidev_cc, cuda, hip, metal.
#backend=cc

# The number of devices the multidev_cc backend exposes (each is a worker domain with its own
# FIFO queue, for debugging multi-device parallel workflows on CPU); 0 means the domain count
# recommended for this machine. Fixed at first use of the backend.
#multidev_num_devices=0

# If true, on GPU backends (cuda, hip, metal) kernels compiled without an explicit `lowered_transform`
# get the default GPU schedule (docs/proposals/schedule-ir-optops.md §6): parallelizable loops are
# annotated / split into Grid x Workgroup pairs when a conservative analysis proves the kernel
# race-free under the annotation; otherwise the kernel runs single-threaded as before. Disabled
# automatically while `debug_log_from_routines` is active (to keep kernel logs serial).
#automatic_gpu_schedule=true

# The workgroup (threadgroup, block) size the default GPU schedule targets: single parallel loops
# are split by this factor; a second parallelizable loop is used as the Workgroup axis directly
# when its extent fits. The configured value is a target: the annotator clamps it to the backend's
# max-threads-per-workgroup device limit (minimum across devices on multi-device backends).
#gpu_schedule_block_size=256

# Kernels whose largest parallelizable loop nest has fewer than this many parallel iterations are
# left unscheduled by the default GPU schedule. The default is low (64): a kernel launches either
# way, so any real parallelism beats the serial 1x1 fallback (a single GPU thread is 1-2 orders
# of magnitude slower than a CPU core). Sub-simdgroup-scale kernels stay serial so that tiny
# programs' segments coalesce back to a single kernel with unchanged placements. Raise this to
# keep more kernels serial, e.g. to make their generated code easier to read.
#gpu_schedule_min_parallel=64

# If true, on CPU backends (cc, multidev_cc) kernels compiled without an explicit
# `lowered_transform` get the default CPU schedule: the same conservative analysis as the GPU
# schedule, retyping each nest's outermost parallelizable loop to Grid, which the C backend
# renders as chunked parallel loops on a native thread pool (see `cc_parallel_grid`). Disabled
# automatically while `debug_log_from_routines` is active.
#automatic_cpu_schedule=true

# Kernels whose largest parallelizable loop nest has fewer than this many parallel iterations are
# left unscheduled by the default CPU schedule (task fan-out overhead would dominate).
#cpu_schedule_min_parallel=16384

# If true (and the automatic schedule for the backend is active), routines are split into multiple
# kernels at cross-workgroup dependency edges — sibling top-level statements whose
# producer/consumer (or WAW/WAR) pairing over a materialized node the default annotator's race
# analysis would otherwise reject, plus bare materialized writes and whole-node zeroing. The
# segment kernels launch in order on the routine's stream with a device-side event chained at
# each boundary (providing the grid-wide synchronization threads within one launch lack) and each
# segment is scheduled on its own launch geometry. Adjacent segments that end up serial are coalesced, so an all-serial
# routine still compiles to a single kernel. If false, such routines compile to one kernel and run
# serially whenever the analysis bails, as before.
#schedule_fission=true

# If true, backend compilation logs one stderr line per compiled kernel/segment with its launch
# grid/block dimensions and statement count — for diffing what two compiles of nominally
# identical code actually emit. Debugging aid; independent of the ppx_minidebug log levels.
#schedule_log_launches=false

# Liveness-based buffer aliasing (the memory planner, gh-ocannl-489). If true, a routine's
# working (non-constant, freshly allocated) tensor-node buffers are laid out in one arena where
# nodes with disjoint live ranges — computed over the routine's final kernel sequence — may share
# bytes, shrinking the routine's device-memory footprint. Only unobservable intermediates that the
# routine writes before reading are eligible; parameters, host-initialized, recurrent, constant
# and observable nodes always keep dedicated bytes. Contract: an aliased node's values are NOT
# preserved past its last read within the routine — reading one from the host or from a
# later-compiled routine raises a User_error (mark the node observable before compiling, or
# disable this setting). Most effective when the whole training step compiles as one routine
# (e.g. Train.grad_update + sgd_update sequenced into a single compilation). Also sinks each
# whole-node zeroing to just before the node's first update (values unchanged), so the gradients
# zeroed up-front by Train.grad_update get liveness-disjoint spans across the backprop chain
# instead of all starting at the zero-grads block.
#buffer_aliasing=false

# If true, linking a liveness-planned routine logs one stderr line with the working pool's arena
# size vs. the dedicated (bump-packed) size and how many nodes were liveness-planned — the
# footprint report accompanying buffer_aliasing. Debugging aid, schedule_log_launches-style.
#log_buffer_aliasing=false

# Rematerialization: a device-memory budget for a compiled routine, in bytes (gh-ocannl-498).
# 0 (the default) disables the pass entirely and leaves compilation bit-for-bit unchanged. A
# positive value, or the word "minimize", makes Train.to_routine plan the routine's inlining
# decision vector before compiling it: materialized intermediates are demoted to recompute-at-use
# (Context.decide_inline) until the routine's scored footprint fits the budget, chosen by footprint
# relief per unit of recompute cost. Deterministic — a planning pass, not a timed search: nothing
# is compiled, linked or executed to make the choice. "minimize" takes every flip that still
# relieves footprint, whatever the recompute cost. Suffixes K/M/G (powers of 1024) are accepted.
# REQUIRES buffer_aliasing=true: the budget is scored against the liveness arena layout, and
# without the planner every node is always-live and the relief of demoting one is meaningless
# (a budget set with the planner off raises a User_error rather than planning against a fiction).
# The budget applies per compiled routine and counts the routine's whole in-context node set —
# parameters included — so it is the peak the routine implies, not just its scratch.
# Takes precedence over model_default_schedule: the budget is scored against the default schedule
# pipeline, and alias spans and arena size are functions of the final segmentation, so a budgeted
# compile uses the pipeline that was scored rather than the cost model's pick (which would link a
# layout nobody scored). Train logs one line to stderr when it overrides the gate that way.
#memory_budget=0

# If true, memory-budget planning logs its decisions to stderr: each inline candidate's
# recompute cost and solo footprint relief, each accepted flip's marginal relief, each candidate
# skipped for relieving nothing on top of the accepted set, and the candidates a max_candidates
# cut left unscored. Debugging aid, log_buffer_aliasing-style.
#log_memory_budget=false

# If true, code generation logs one stderr line per declined rendering, naming the kernel, the
# construct, and the rule that failed: a Grid loop that fails pool-parallel eligibility (an
# ineligible local and which of the shared/privatization rules it broke, or the per-chunk
# footprint cap), and a Tile_mma statement that falls back from the intrinsic or register-tiled
# rendering (the failed rule plus the statement's precisions, extents, transposition flags and
# operand address spaces). Declines are silent by design — the fallback is correct — but
# indistinguishable from the intended rendering in timings; this is the "why did my schedule
# render serial/scalar" switch for hand schedules and autotune runs.
#schedule_log_declines=false

# gh-494: run the legacy procedural schedule-legality analyses alongside the affine conflict
# queries (arrayjit/lib/affine.ml) that replaced them, and compare. A query stricter than the
# procedural answer raises (a query precision regression, or a latent unsoundness of the procedural
# rule); a query more permissive than the procedural answer is the expected precision gain, logged
# to stderr. A debugging/soak switch: off by default, no effect on behavior beyond the comparison.
#legality_crosscheck=false

# How the C backend renders eligible outermost Grid loops (pool-backed Grid rendering,
# docs/proposals/gh-ocannl-164.md): "dispatch" uses libdispatch's dispatch_apply (macOS),
# "openmp" uses `#pragma omp parallel for` (adds -fopenmp to the kernel compile), "none" keeps
# serial loops, "auto" (default) probes what the configured compiler accepts. Both runtimes own a
# single process-global thread pool; worker threads run pure C and never touch the OCaml runtime.
# Applies to explicitly annotated (schedule-transformed) kernels as well as the automatic
# schedule; results are bitwise identical to serial execution (grid iterations write disjoint
# elements).
#cc_parallel_grid=auto

# Target chunk count for parallel Grid rendering; the actual count is capped by the loop extent.
# 0 (default) means automatic: 4 x the worker-pool width (the pool-policy result, see
# cc_pool_core_class; affinity-respecting, so a pinned run gets a matching grid decomposition).
#cc_parallel_chunks=0

# Worker-pool uniformity policy on hybrid CPUs (gh-ocannl-530,
# docs/proposals/gh-ocannl-530-pool-uniformity.md). One OpenMP pool mixing two core speeds costs
# tuned schedules 20-31% (chunked Grid loops end at a barrier, so the step is set by the slowest
# worker), while restricting the pool to one core class recovers 25-34% of tuned time at no
# measured cost to default (untuned) runs. "auto" (default) restricts the process to the
# highest-performance core class when ALL of: the pool is OpenMP (not libdispatch/none), the
# topology probe reports 2+ core classes with usable affinity masks, the machine is not
# virtualized (guest topology is fabricated, e.g. under WSL2), and the process is not already
# externally pinned below the full machine (an external mask is respected as the user's pool
# decision). "all" never restricts (pre-gh-530 behavior). "performance"/"efficiency" force that
# class on a hybrid topology, overriding an external pinning and skipping the hypervisor gate;
# "efficiency" picks the class just below the performance class (not the slowest - on three-class
# parts the low-power island is a near-serial pool). The restriction is process-scoped: a
# mixed-backend program wanting full-width host threads alongside occasional cc kernels should
# set "all". Changing the effective pool changes the autotune cache key (crowned schedules do
# not transfer across pools), so a flip re-tunes instead of replaying stale crowns.
#cc_pool_core_class=auto

# Byte cap on the combined footprint of the per-chunk privatized tiles of one pool-parallel Grid
# loop (block-scope arrays living on the pool workers' stacks; see the privatization rule in
# c_syntax.ml's parallel_grid_safe). A loop whose privatized locals exceed the cap renders serial
# instead (log with schedule_log_declines). The default, 262144 (256KB), leaves headroom under
# libdispatch's default 512KB worker stacks; raise it when the pool's worker stacks are known
# larger (e.g. under OMP_STACKSIZE with the OpenMP rendering) — for instance to let a
# grid-outermost packed GEMM re-pack a whole B~ panel per chunk. Values <= 0 fall back to the
# default.
#cc_grid_private_bytes_cap=262144

# Vector register width in bytes for explicit SIMD rendering of Vectorized-typed loops in the C
# backends (GCC/Clang vector extensions): eligible loop bodies emit vector loads/arithmetic/stores
# in width/element-size lanes plus a serial remainder, instead of relying on the compiler's
# auto-vectorizer (which e.g. cannot reassociate strict-FP reductions -- the Vectorized retype
# carries that permission, like schedule Swap). A recognized accumulation body
# (acc = op(acc, contrib(i)), op one of + * max min, or the FMA form) renders as independent
# vector accumulator chains with a horizontal reduce at loop exit (ggml's vec_dot pattern).
# Unset or -1 means automatic: 64 when the target has AVX-512 (F, BW and VL — probed the same way
# as the AVX2 stage, by asserting what the configured target already has rather than requesting
# it), 32 when the SIMD probe finds AVX2, else 16 (NEON). 0 disables
# explicit emission (pragma-hinted auto-vectorization remains). Ineligible bodies
# (non-elementwise, non-contiguous, cross-lane flow) keep the pragma rendering; ineligible
# ACCUMULATING bodies fall back to a plain serial loop instead (the pragmas would assert
# iteration independence).
# A loop or micro-kernel column extent too short to fill the configured vector degrades to the
# widest width it can fill (never below 32 bytes, i.e. never below the pre-AVX-512 default), rather
# than declining to a serial rendering — so raising the width cannot lose a vectorization.
# On Zen 5 the 64-byte width measures 1.7x the 32-byte one on the packed f32 GEBP of
# bin/narrow_gebp_bench (225.7 vs 130.5 GFLOP/s at n=512, identical checksums). Pin 32 where
# sustained 512-bit work is unwanted (Intel server parts clock down under it). The width is part
# of the schedule cache's key, so changing it re-tunes rather than replaying a crown from the
# other width.
#cc_vector_bytes=-1

# Whether `Autotune.tune` searches at all. With false, no candidate is ever compiled or timed,
# and a cache miss compiles the untuned default pipeline, exactly as if `Autotune.tune` had not
# been called. Crowning a schedule by measurement is the largest cross-machine determinism leak
# (schedule identity pins numerics), which is why the `reproducible` profile turns it off.
# A committed schedule cache still replays -- a pinned schedule is deterministic -- but only from
# a CHOSEN autotune_cache_dir: one passed to `Autotune.tune` or set at some config source. With
# the search off the built-in default directory counts as no cache, so a run cannot silently pin
# itself to whatever an earlier local search left in ./autotune_cache. (With the search on the
# default cache behaves as it always has -- a search that misses rewrites it.)
#autotune_search=true

# The beam width of `Autotune.tune`'s empirical schedule search: how many of the fastest
# candidates each round expands with further schedule ops.
#autotune_beam_width=2

# The maximum number of beam-expansion rounds beyond the seed candidates (the serial baseline and
# the default-annotator block-size sweep). The search also stops when a round improves the best
# time by less than 1%.
#autotune_rounds=2

# Timed runs per tuning candidate (after one warmup run); the minimum is kept. Under
# autotune_timing=queued each such run is a whole batch of dispatches, so this is a floor on
# batches rather than on launches.
#autotune_repeats=3

# What a tuning candidate's time is a measurement OF (gh-ocannl-755).
#   queued   -- the default. A calibrated number of launches is dispatched back to back with a
#               single host synchronization and the wall time is divided by the count, so the
#               submit/sync round trip is amortized and the number is what the kernel sustains
#               inside a stream that already has work in it. That is what a training step
#               presents: it queues every kernel of a layer and synchronizes at the end, so no
#               kernel in it pays a round trip of its own. The batch depth is calibrated per
#               candidate to about 10 ms of wall time, capped at 2048 launches on CUDA/HIP and at
#               the historical 200 on cc/Metal, and floored at 1 -- a routine slower than that
#               target is measured exactly as "isolated" measures it. Metal's measured ~59-launch
#               target stays below either cap; keeping cc at 200 avoids multiplying CPU autotune
#               suite cost for a GPU dispatch-scale correction.
#   isolated -- one launch followed by a host synchronization: the latency of a lone dispatch,
#               kernel plus one round trip. What every schedule crowned before gh-ocannl-755 was
#               ranked by, and the right objective for a workload that really does dispatch one
#               kernel and wait for it.
# The two are different objectives and they do not crown the same candidate. On gfx1151 the round
# trip is ~50-60 us while the fastest candidates at the gpt2_mini out-projection shape run in
# 60-70 us, so "isolated" reads about 2x the steady-state cost there -- and the offset varies from
# candidate to candidate with the block count and the per-launch queue work, which is what lets two
# candidates 10% apart in steady state swap places. A best_ms measured under "isolated" is
# therefore not a throughput number and must not be compared against a batched per-kernel figure.
# The ~25 ms top-up budget accumulates PER-LAUNCH samples in both modes, not queued-batch wall. A
# fast queued candidate can therefore take all 64 timed batches (about 640 ms when calibration hits
# the 10 ms target). On CUDA/HIP, before those, one provisional, up to four validating batch probes,
# and a final confirmation take twelve samples each; one confirmation outlier over 2x its supported
# base is retried once, so seven near-target probes can cost about another 840 ms per candidate.
# cc/Metal retain the historical single-estimate calibration. These are
# workload-dependent costs, not a shared wall-time ceiling; the exact worst-case dispatch-count
# bounds are documented on Autotune.time_routine.
# The objective is part of the schedule disk-cache key (the "timing" component), so entries do not
# transfer between the two modes and entries written before gh-ocannl-755 are not replayed: an entry
# crowned under one objective is not the answer to a search asking the other, and the times it
# stores are readings of a different quantity. Changing this setting therefore re-tunes rather than
# replaying, which is the point.
#autotune_timing=queued

# Directory of the autotuner's schedule disk cache, keyed by the canonical digest of the
# optimized code, the backend name, a digest of the numerics policy (tf32_matmuls,
# narrow_compute_f32, fp16_arithmetic -- gh-ocannl-568: the policy is not part of the code, so
# without it a default-flags run would replay a tf32-tuned winner it cannot render), a digest of
# the codegen configuration (large_models, buffer_aliasing, the effective routine-logging
# predicate, the logging-only settings once it holds, and the compiling backend's own knobs --
# for cc the compiler command and flags, the OpenMP team, cc_vector_bytes, cc_fp16_arithmetic,
# cc_parallel_grid/chunks, cc_grid_private_bytes_cap; for CUDA and HIP the graph-capture regime
# and debug compilation:
# all read AFTER lowering, so they are likewise invisible to the digest, gh-ocannl-572, together
# with the device's hardware limits and, on cc, a fingerprint of the toolchain's predefined macros
# under the configured flags -- so entries do not transfer between unlike devices or toolchains),
# and the worker-pool signature on CPU
# backends (gh-ocannl-530). Runs under different regimes therefore keep separate entries and can
# share one directory; flipping any of those knobs re-tunes rather than replaying a winner
# crowned elsewhere. Which key belongs to which component is recorded key by key in
# `Utils.config_key_classification` and checked by `test/operations/digest_completeness`.
# Relative paths resolve against the working directory.
# An empty value disables the cache (every `Autotune.tune` call searches afresh).
#autotune_cache_dir=autotune_cache

# Candidate-volume cap on `Autotune.tune`'s split-reduce seed family (gh-ocannl-484 task 3): the
# top so-many detected reduction-dominated sites, ranked by estimated segment cost (the
# accumulation's trip count), are seeded with a few `num_blocks` values each. Sites the cap
# evicts are recorded in the report's decline census rather than dropped silently
# (gh-ocannl-541). 0 disables the family.
#autotune_split_reduce_max_sites=8

# If true, `Autotune.tune` logs each candidate to stderr: its spec, whether it failed (with the
# error message), deduplicated against an already-seen post-schedule digest, or was timed (and
# its time), plus the cache-hit, winner-replay and fallback outcomes. For debugging search
# quality; independent of the ppx_minidebug log levels.
# It also emits one `census` line per candidate attempt (gh-550): the live pools, contexts and
# loaded code modules of `Ir.Alloc_census` next to the backend's own device-memory figure, so a
# search's memory growth can be attributed to an allocation class rather than sampled from outside
# the process.
#autotune_log=false

# gh-555: budget for the greedy per-node inlining refinement of `Train.tune_placements` — after
# the placement A/B, try flipping up to this many of the winning arm's most expensive inlining
# decisions (materialize a policy-virtual node / inline a cap-materialized one), each accepted
# flip becoming the base for the next. Every tried flip costs a full `Autotune.tune` search like
# an arm; 0 (the default) keeps the plain A/B behavior. A flip is accepted on a measured
# improvement, so the refinement is a determinism leak of the same kind as the schedule search --
# and one that is not numerics-neutral, since a materialized node rounds to its storage precision
# where an inlined one does not. The `reproducible` profile pins it at 0; `performance` leaves it
# alone, its cost being a full search per candidate; `approximate` sets it to 2.
#tune_inline_flips=0

# gh-ocannl-638: which placement arm `Train.tune_placements` ships. `auto` (the default) ships the
# measured winner of the A/B — or, when tune_inline_flips is positive and the greedy refinement
# beats that winner, the refined placement vector, which is neither arm (reported as "flip" through
# the `on_ship` callback; read that, not the arms' times, to identify the returned routine). `a` (alias `default`) forces the default-placement arm and `b` (alias
# `materialize-all`) forces the materialize-all arm, whatever the timings said. MEASUREMENT-ONLY:
# this is the optimizer's shipping path, so a non-default setting announces itself on stderr
# regardless of autotune_log, once when it is resolved and once at the decision it changes. It
# exists because a profile of one arm's kernels is evidence about that arm's routine, and until
# that routine is the one that ships nothing ever executes it against a reference — the gap
# benchmarks/report-gh612-hip.md had to state in its verdict. Both arms are still searched, so the
# A-vs-B comparison a report quotes is unaffected and both arms still report in position; forcing
# additionally skips the tune_inline_flips refinement (a refined placement vector is neither arm),
# and a forced arm whose search failed propagates that failure instead of falling back to the other
# arm.
#tune_ship_arm=auto

# gh-ocannl-514: the ranking of the flip chain's candidates. `enablement` sorts the
# decision surface family-first: a `materialize` flip whose node is an operand or destination of
# an mma-eligible matmul site that exists only in the all-materialized specialization — so its
# materialization is what makes the tensorized family expressible — ranks ahead of every
# recompute-cost rank, and an `inline` flip of an operand or destination of any eligible site
# ranks last (it can only move away from that family); recompute cost descending within each
# class. `cost` restores the pure recompute-cost order (gh-555's), kept as the evaluation
# baseline: on gh-558's mlp_wide/hip/bf16 cell it buried the family-unlocking cast twins below
# four no-op inline flips and a budget-5 chain found nothing. With autotune_bound_pruning=true
# the chain additionally skips, without spending budget, any materialize flip whose
# partial-placement-vector roofline floor (`Cost_model.completion_floor` on the all-materialized
# lowering, monotone in the chain's accumulated commitments) already meets the best measured
# time — the same admissible direction as the sketch-level pruning.
#
# gh-ocannl-579: `profitable` (the default) is `enablement` weighed against what the placement A/B
# arms MEASURED about the family the prior points at. The prior models expressibility and has no
# profitability term, and on gh-514's metal/f16 mlp_wide cell that costs the run: the two promoted
# cast twins take budget slots 1-2, the family they unlock times 79-92 ms against the arm's 7.5 ms,
# and the cheap winning `inline` flip (rank 5 under cost) falls out of a budget-5 chain — cost
# ordering shipped 6.55/6.64 ms there against enablement's 7.03-7.14 ms. Arm B (materialize-all) is
# the specialization the prior derives enablement from and it is searched before the chain walks, so
# its report's `mma_best_ms` against `best_ms` settles the question for free, on this device, on this
# computation. Competitive or never timed: the prior stands (on hip's cell the family IS the arm's
# winner, and gh-558's budget-5 failure stays closed). Measured to lose by more than
# tune_flip_profit_margin: both of the prior's classes go at once — the promotion of family-unlocking
# flips and the demotion of family-breaking ones are the same bet on the same family — and the
# ranking degenerates to `cost`. `enablement` keeps the pure prior as the other evaluation baseline.
#tune_flip_ordering=profitable

# gh-ocannl-579: how much worse than a search's best the best TIMED tensorized candidate may be and
# still be worth a flip-budget slot under tune_flip_ordering=profitable, as a ratio of at least 1.0.
# The default admits a family that lost by up to a quarter — a gap one more placement flip could
# plausibly close — and rejects the measured cells that motivated the term by a wide margin (metal
# ~12x, cuda ~2.3x, against hip's 1.0x where the family won), so no verdict there is knife-edge.
# Raise it to keep promoting on a machine whose tensorized path is still being brought up;
# tune_flip_ordering=enablement disables the term outright — and disables it in the strong sense:
# under either unconditional ordering the evidence is never derived, so this key is never read and a
# malformed value cannot fail a run pinned to a baseline.
#tune_flip_profit_margin=1.25

# If true, an exception crossing a candidate transform/codegen/compile/link boundary is fatal unless
# a narrow compiler seam or the backend classifies it. If false, unattributed compile-side failures
# of tuner/advisory/cache work are temporarily contained as `Unclassified` declines. Launch and sync
# failures remain fatal unless classified, and public user schedules retain their exception behavior.
#strict_failure_classification=true

# The analytic-cost-model pre-filter of `Autotune.tune`'s sketch seeding (gh-ocannl-491): per
# candidate family (the whole-routine sketches; each fission segment's sketches), candidates are
# ranked by the roofline model and only the best `autotune_keep_fraction` of the model-scored
# ones are compiled and timed. 1 disables the pre-filter. Candidates without model coverage —
# opaque code, a schedule the model cannot apply, missing envelope constants — are never
# dropped, only measured, so the model never overrides (or precludes) a measured result and the
# outcome is independent of enumeration order. Presets, saved schedules and the serial baseline
# are never pruned.
#autotune_keep_fraction=1

# If true, `Autotune.tune` prunes enumerative sketch candidates (whole-routine and per-segment
# sketches, split-reduce seeds) whose schedule-invariant roofline FLOOR
# (`Cost_model.completion_floor` under the envelope constants) meets the best measured time so
# far: such a candidate provably cannot win, so its compile and timing are skipped
# (gh-ocannl-514 phase 4b; the report's bound_pruned counts them). Admissible-direction pruning
# only — presets, saved schedules and the serial baseline are never pruned, and pruning is
# sound exactly when the envelope constants are honest peaks (the continuous bound-vs-measured
# agreement check guards them; an understated envelope over-prunes, which is why this is off by
# default and changes which candidates get timed when on).
#autotune_bound_pruning=false

# When non-empty, `Autotune.tune` appends one tab-separated calibration row per timed candidate
# to this file: backend, digest tag, tuned routine name (the computation's block-comment name,
# the one its generated sources carry), candidate label, measured ms, model-roofline ms (empty
# when the model cannot score the candidate), kernel count, flops, bytes, flops-approx flag,
# bytes-approx flag (the leg's counts are guards-taken/union upper bounds rather than exact),
# opaque flag. Reports name a row as `routine/label (digest)`, so a fitted constant says which
# kernel demonstrated it. Milliseconds are floored at the 6th decimal, so a stored time never
# exceeds the measurement. The flops and bytes columns aggregate over the candidate's kernels
# while the model column sums per-kernel roofline bounds. Every tuning run is free model-vs-measured
# divergence data for fitting the envelope constants (see model_peak_flops):
# `tools/fit_envelope.exe <file>...` fits the tightest model_peak_* constants respecting every
# row each leg can be audited on (a leg fits from the rows where that leg's counts are exact;
# opaque rows are excluded; fully-exact multi-kernel rows constrain via a uniform "fission
# slack" on both legs) and prints
# config-pasteable lines; `--backend=NAME` selects one backend when the data spans several (the
# keys are global), `--margin=F` (F >= 1) adds headroom for candidates faster than any yet
# measured. Rows recorded before the routine column (11-column schema) still fit, unnamed;
# rows recorded before the approx column (9-column schema) are skipped with a warning — prefer
# re-recording calibration data with the current build.
# Ordinary (matmul-family) tuning data cannot constrain the memory leg: those rows are
# compute-bound and usually carry approximate byte counts (gh-ocannl-578). To make
# model_peak_memory_bandwidth fittable, run the STREAM-style footprint-exact calibration pass
# `tools/calibrate_bandwidth.exe --ocannl_autotune_calibration_file=<file>` once per machine and
# backend: it appends bytes-exact streaming rows through the same emission path (verifying they
# came out exact), then refits the whole file and prints the config-pasteable constants.
# Relative paths resolve against the working directory. With autotune_log=true the same
# calibration lines also go to stderr, human-readable.
#autotune_calibration_file=

# If true, untuned compiles issued by the recipes (`Train.to_routine`, `Train.run_once` and its
# wrappers, the benchmark runners' untuned arms) pick the default schedule with the analytic
# cost model (`Autotune.model_default`, gh-ocannl-491): the untuned default pipeline and the
# sketch families are scored with the roofline model and the best is applied — zero timing runs,
# one backend compile. Advisory: requires envelope constants (the backend's advisory values or
# the model_peak_* overrides below), ties go to the default pipeline, and any scoring,
# application, validation or compilation failure falls back to it — a pick rejected by
# `Low_level.validate_parallel` (or by anything else downstream of the schedule seam) is
# recompiled with the default pipeline instead of failing the compile. Candidates whose
# scheduled form fails that same check are excluded from the ranking, so the model chooses
# among schedules that can actually be built.
#model_default_schedule=false

# gh-ocannl-514, the placement levels of the untuned regime: with model_default_schedule=true and
# this set to N > 0, `Autotune.model_default` first branch-and-bounds over the top-N ranked flip
# candidates of the placement decision surface (see tune_flip_ordering) — each level a keep/flip
# choice, each leaf a placement vector whose hermetic lowering is scored by the same selection
# that scores the pipelines (so the search is joint over placements and sketch families), the
# all-keep leaf scored first so ties stay with the default placements, and subtrees fathomed by
# the partial vector's roofline floor, which unlike the sketch levels' schedule-invariant floor
# tightens as materialize commitments accumulate (gh-ocannl-514 phase 3). The picked vector is
# applied via the same context-level decisions as `Train.tune_placements`' flips and remains
# advisory: any classified failure under the picked placements falls back to selecting from the
# caller's own placements. Zero timing runs either way; the walk costs up to 2^N hermetic
# lowerings plus model scoring, so keep N small (the levels beyond N keep their default
# placements). 0 (the default) disables the placement levels.
#model_default_placements=0

# gh-ocannl-514 phase 5: with model_default_schedule=true, lift the tile-size lattice branches of
# the sketch family trees into `Autotune.model_default`'s search. The lattice extends the curated
# geometry menus to every intrinsic-tile multiple of the staged block sizes, organized as binary
# interval boxes: a box is refuted from its most favorable corner when even the smallest tiles
# exceed the workgroup-memory floor, and fathomed when the roofline floor plus the box's certain
# staging traffic (monotone in the box's minima) already meets the incumbent score — so the
# search visits a logarithmic-effective slice of the lattice instead of enumerating it, which is
# the regime where branch-and-bound strictly dominates the beam (the ledger lines under
# autotune_log report expanded/scored/fathomed). The model-argmin may then pick a geometry no
# curated menu contains; the pick stays advisory and validated like any other. Never affects
# `Autotune.tune`'s seed lists or anything measured: the lattice branches are excluded from
# `leaves` by construction. Off by default.
#model_default_geometry_lattice=false

# Overrides the backend's advisory peak arithmetic throughput, in FLOP/s (single precision, FMA
# counted as two operations), used as the compute leg of the analytic cost model's roofline
# envelope. Calibrated per-machine values (fit from autotune_calibration_file data with
# tools/fit_envelope.exe) beat the backends' class-level constants; unset/empty uses the
# backend's value (the C backends provide none, so scoring on them requires setting this and/or
# model_peak_memory_bandwidth). The constants must be honest peaks — at least the machine's
# achievable throughput: whenever envelope constants are present, every candidate timed by
# `Autotune.tune` checks the roofline lower bound against its measured time and an exceedance
# attributable to exact counts warns unconditionally on stderr (gh-ocannl-514; understated
# peaks would let a bound-driven search prune true winners), prompting a refit — the implied
# minima name only legs that are configured and exactly counted. When only an approximate
# (guards-taken) leg can explain the exceedance it may reflect over-counting instead, so it
# logs only under autotune_log.
#model_peak_flops=

# Overrides the backend's advisory peak main-memory bandwidth, in bytes/s — the memory leg of
# the roofline envelope. Same contract as model_peak_flops. Tuning workloads rarely demonstrate
# achievable bandwidth (compute-bound, approximate byte counts): fit this leg from the
# streaming rows of `tools/calibrate_bandwidth.exe` (gh-ocannl-578; see
# autotune_calibration_file).
#model_peak_memory_bandwidth=

# If true, stdout capturing is disabled, so some logs meant for the ppx_minidebug log files
# (in particular CUDA logs) remain on the stdout.
#
# NOTE: current implementation of stdout capture loses information on channel
# buffering overflows, so it is important to verify with this setting if one gets
# sufficient information in the logs files.
#never_capture_stdout=false

# If `false`, debug logs from routines are re-logged via the ppx_minidebug framework.
# If `true`, the logs are in stream-specific files. WARNING: files are appended to, not overwritten.
#debug_log_to_stream_files=false

# If set and relevant, it's the `CU_LIMIT_PRINTF_FIFO_SIZE` CUDA configuration.
#cuda_printf_fifo_size=

# If set and relevant, it's the `hipLimitPrintfFifoSize` HIP configuration.
#hip_printf_fifo_size=

# If `true` (the default), the HIP backend checks a freshly linked kernel's private (scratch)
# segment size against what the device can back at full occupancy, and declines an over-budget
# kernel as `Resource_exceeded Thread_scratch` instead of launching it. Launching one aborts the
# HSA queue outright (`[UpdateScratch] scratch_size overflow!`), which no handler can contain and
# which takes down unrelated work on the stream (gh-ocannl-533). Set to `false` on a device where
# the budget model is wrong -- it was calibrated on gfx1151/ROCm 7.14 -- if valid kernels are
# being rejected.
#hip_scratch_validation=true

# The `-O` argument to the compiler executable for the `cc` and `multidev_cc` backends.
#cc_backend_optimization_level=3

# The `cc` and `multidev_cc` backends compiler executable name.
# By default, `ocamlc -config` field `c_compiler` is used.
#cc_backend_compiler_command=

# Additional architecture-specific flags for the CC backend compiler invocation.
# The default "auto" targets the host CPU with the spelling that architecture uses, probed once
# per process: `-mcpu=native` on ARM, `-march=native` on x86, nothing if the compiler rejects it.
# The distinction matters -- Apple clang accepts `-march=native` on arm64 and DOWNGRADES the
# target with it, losing __ARM_FEATURE_FP16_VECTOR_ARITHMETIC among others, while on x86 `-mcpu=`
# is an alias for `-mtune=` and would not select the ISA at all. The value "none" passes no
# architecture flag at all -- the portable baseline, spelled as a word because a config source
# cannot carry an empty value ("" means unset), which is how the `reproducible` profile pins it.
# Any other value is passed through verbatim (`-march=native` restores the pre-gh-517 behavior).
#
# PERFORMANCE CLIFF on a target with no fused multiply-add INSTRUCTION (gh-ocannl-753). The code
# generator rewrites every floating-point `a*b + c` into a fused multiply-add and spells it `fmaf`
# / `fma`: in the serial rendering, in the scalar peel of a vectorized loop, and -- where the
# target offers no whole-vector FMA builtin -- once per lane inside the vector body. Where the
# target has the instruction, the compiler normally contracts all of those into it and no call
# survives -- normally, not always: this is the compiler's lowering decision, and it is not
# guaranteed at every optimization level (gcc has been reported to keep the calls at `-O0` even on
# an FMA-capable target, see the diagnostic below). Where the target does NOT have it, each call
# stays a libm CALL -- unless the arithmetic itself is relaxed, since cc_backend_fast_math can make
# clang expand the calls into a multiply and an add (see that key) -- and an opaque call cannot be
# vectorized, so the loop around it can degrade badly: gh-ocannl-753's gcc census reports it fully
# scalarized at -O3 (64-byte width, f32, `-march=x86-64`: 324 instructions, 0 vector operations, 256
# scalar, 64 libm calls, 128 stack references). That census is gcc's; clang measured here keeps the
# surrounding loop packed at both -O2 and -O3 (26 packed ops, 0 scalar) while still emitting the
# per-lane calls -- so treat the scalarization as a gcc-observed amplifier, not as universal.
# The condition is whether the compiler can lower those `fmaf` / `fma` calls to SOME fused
# instruction the target has -- FMA3 or FMA4 on x86, `__ARM_FEATURE_FMA` on aarch64 (baseline
# there, so no ARM host is affected). It is not any one feature macro, and still less the
# `x86-64-v3` level: naming a proxy for it is how both of the wrong prescriptions this entry
# previously carried got written. Three real families show the spread, all measured with clang
# cross-targeting x86_64 (recipe in the SIMD agent note):
#   `-march=x86-64` and `-march=x86-64-v2` -- no FMA at all: one `fmaf` call per lane per iteration
#   (4 calls at 4 lanes, 8 at 8), and a call per iteration in the scalar loop. This is the cliff.
#   `-march=bdver2` / `bdver3` (Piledriver, Steamroller) -- FMA3 with AVX but no AVX2: zero calls.
#   `-march=bdver1` (Bulldozer) -- FMA4 ONLY, defining `__FMA4__` and `__XOP__` but not `__FMA__`:
#   also zero calls, compiling to the four-operand `vfmaddps` / `vfmaddss`.
# So `__FMA__` is not necessary (bdver1 lacks it and has no cliff), and the v3 level is not the
# only way to get FMA3 (bdver2/bdver3 have it without AVX2). The diagnostic that answers the
# question directly, for your compiler and target TOGETHER rather than through a macro proxy, is to
# compile and look -- with the SAME flags the backend uses, because it composes several settings and
# a probe missing any of them answers about a different compilation than yours: `-O` at
# cc_backend_optimization_level (default 3), then cc_backend_arch_flags, then the resolved
# cc_backend_simd_flags, then `-ffast-math`, `-ffp-contract=`, `-fopenmp`, in that order. An
# explicit `cc_backend_simd_flags=-mfma` makes a bare `-march=x86-64` probe report calls your
# kernels do not have; cc_backend_fast_math can remove calls the probe still shows. Compile a small
# `fmaf` loop of your own with that flag set and `-S`, into an `.s` path of your choosing.
# To read the backend's REAL invocation instead of reconstructing it: rebuild with
# `OCANNL_LOG_LEVEL_CC_BACKEND=9` (a preprocessing-time gate -- a runtime log_level alone leaves the
# call stripped, and the values 1 and 3 do not currently compile), then run with log_level=9 and
# debug_backend=text. The command appears under a `command` node, e.g.
#   cc '<...>.c' -O3 -mcpu=native -o '<...>.so' -bundle -undefined dynamic_lookup > '<...>' 2>&1
# Look in the right place: with log_main_domain_to_stdout at its default of false, the text log is
# an EXTENSIONLESS file named by log_file_stem, never a `*.log`. Its directory follows
# build_files_prefix, like every other artifact: unset gives `log_files/<exe>/debug`, an explicit
# prefix gives `log_files/<prefix>/debug`, and `.` gives a flat `log_files/debug`. Only
# with log_main_domain_to_stdout=true does it go to stdout instead.
# Rerun that with `-S` added AND its `-o` pointed at a fresh `.s`: left as it is, `-S` writes
# assembly text over the shared library the command was building, which may be one your application
# still has loaded.
# Then `grep -E 'call.*fmaf?\b' kernel.s` -- name the assembly file literally. With the operand
# there, no match (exit status 1) is a REAL answer: that assembly contains none of the call
# spellings below, so that kernel is clear of THIS cliff. It does not certify the kernel fast in
# general: on gcc with an FMA4-only target the emission takes `vec_acc_fma`'s per-lane arm, which has
# no libm calls to find and is still the spill-or-scalarize hazard the SIMD note describes -- passing
# this check and taking the good arm are separate questions. It is the operand-less form that tells you
# nothing -- a bare `grep` reads stdin instead of the file, and a placeholder like the
# angle-bracketed one is worse still, since the shell reads it as redirection and truncates the very
# file you meant to inspect. Match BOTH names and both dialects: double-precision kernels call
# `fma`, not `fmaf` (that is what `Ops.ternop_c_syntax` emits for `Double_prec`); clang on Mach-O
# spells the calls `callq _fma` / `callq _fmaf` (measured here), and gcc on ELF spells them
# `call fma@PLT` / `call fmaf@PLT` (reported in review on gh-ocannl-753, not reproduced here) --
# note the double-precision symbol is `fma`, without the `f`. A pattern pinned to
# one name or one dialect reports zero on the other, and an FMA-less target then reads as clean --
# an `fmaf`-only pattern misses every call in a double-precision kernel. Note also that gcc has been
# reported to keep `fma@PLT` / `fmaf@PLT` at `-O0` even on an FMA-capable target, where clang
# measurably does not (zero calls at every level from -O0 to -O3 on `-march=x86-64-v3`). That cuts
# one way only: at the `-O` your build actually uses, finding the calls IS the answer about your
# kernels -- if you run at cc_backend_optimization_level=0 under gcc and see `fma@PLT`, your kernels
# have them. What a low-`-O` result does not support is EXTRAPOLATION to a different level.
# Provenance of everything above: the target rows, the flag-composition effects and the grep pattern
# were executed on arm64 macOS with Apple clang cross-targeting x86_64 (`clang -arch x86_64`). The
# gcc-sourced statements -- calls retained at `-O0`, `-ffast-math` NOT expanding them, the `@PLT`
# call spellings, the three-operand `vfmadd132ps` for `__builtin_ia32_vfmaddps`, and the fully
# scalarized -O3 loop -- come from code review on gh-ocannl-753 or from that issue's census, and
# none was reproducible here, which has no GNU gcc; each is flagged in place. Claims about what the
# CODE does (the rewrite, the spelling, the builtin guards, the flag composition, the fold
# structure, the census predicate) are from reading those expressions, not their comments. For an in-tree check that runs on whatever toolchain you have,
# `test/operations/cc_march_census` compiles the emitted kernel across `-march` targets and censuses
# the accumulator loops, holding the line that no FMA loop calls libm where the ISA has an FMA --
# for the FMA3 and NEON paths only. It does NOT cover FMA4: its capability predicate is
# `has_fma = has "__FMA__" || has "__ARM_FEATURE_FMA"`, with no `__FMA4__`, and its target matrix
# has no `bdver` row, so it stays green whatever the FMA4 path does. Extending it is unfiled work.
# You reach a no-FMA target on ANY CPU that lacks a fused multiply-add, which is not a clean date
# cutoff. Big-core x86 got FMA3 at Haswell and AMD got FMA4 at Bulldozer, but the low-power lines
# shipped without either for years afterwards: Intel Silvermont, Goldmont and Tremont, and AMD
# Jaguar (`btver2`), define neither `__FMA__` nor `__FMA4__` and hit this under a perfectly
# successful `-march=native`. Treat generations as examples, never as a boundary.
# You also reach it by pinning
# this key to "none" (as the `reproducible` profile does -- though it also pins cc_vector_bytes to
# 0, so only the serial calls remain there) or to a `-march` without FMA, or by using a toolchain
# that rejects the probed `-march=native`, in which case the probe falls back to no flag at all and
# the compiler's own baseline target applies. So do NOT rule the cliff out from the CPU alone: under
# the default "auto" an FMA-capable host clears this only if the `-march=native` probe actually
# succeeded (or the compiler's own default target already includes FMA) AND the configured compiler
# actually lowers the calls at your `-O` -- probe success selects a capable target, it does not
# establish that no call survives. Where it matters, answer
# it for the box in front of you with the compile-and-grep diagnostic above rather than from the
# part number.
# For FLOATING-POINT precisions this is a cost of CORRECTNESS, not a defect -- but be precise about
# WHICH promise is at stake, because it is not whole-result bit equality. A vectorized reduction
# already reassociates: `C_syntax.vec_acc_grid_fold` folds the register grid into one accumulator
# and `vec_acc_lane_fold` then chains that vector's lanes into a scalar, so the lanes accumulate
# independently and are combined at the end -- a different summation order from the serial
# fallback's. (That is also why the `reproducible` profile pins cc_vector_bytes=0, to keep the
# serial order.) What the emission does guarantee is the rounding of
# each individual UPDATE: an FMA rounds once, and the vector body, its scalar peel and the serial
# fallback all spell that same single-rounded operation, so they differ only by summation order and
# not by the semantics of each step. Substituting `a*b + dst` where the instruction is absent would
# round every update twice, changing that per-step semantics on top of the reassociation -- a second,
# independent numerics change. An opt-in to that trade is deliberately not offered here; it belongs
# with the approximate-numerics work (gh-ocannl-719). (The rewrite itself is not restricted to floating
# point, and that is a separate question, not a rationale this note covers -- see the SIMD agent
# note.)
# What removes the calls is a target the CPU actually implements -- and that is a fix ONLY when the
# CPU has an FMA that a conservative compiler target was hiding. On a CPU with no FMA at all (the
# Silvermont / Goldmont / Tremont / Jaguar cases above) there is no target to raise to: every
# FMA-capable `-march` names instructions that part cannot execute, so raising it trades the
# slowdown for an illegal-instruction fault. Such a machine keeps the cliff, and the only things
# that change it are changing the arithmetic (cc_backend_fast_math, with its own caveats below) or
# running elsewhere. Where the hardware IS capable, prefer the spellings that let the compiler read
# the host over ones that assert a feature. "auto" (the default) is the one to reach for: it probes
# the host's own family and uses that family's native spelling. Do NOT hand-write `-march=native`
# unless you are on x86 -- it is the x86 spelling only, and Apple clang accepts it on arm64 while
# DOWNGRADING the target (the top of this entry has the details), so writing it by hand on ARM undoes
# the protection `auto` gives you; the ARM spelling is `-mcpu=native`. Naming a specific part works
# too, but the option differs by architecture the same way: on x86 the CPU goes in `-march`
# (`-march=bdver2`), while on ARM `-march` takes an ARCHITECTURE (`-march=armv8-a`) and a CPU needs
# `-mcpu` (`-mcpu=cortex-a72`; `-march=cortex-a72` is rejected outright). This value is passed
# through verbatim with no probe behind it, so a spelling the compiler rejects fails the kernel
# compile rather than quietly falling back.
# Explicit feature flags work but must match the part, and getting that wrong costs a SIGILL rather
# than a slowdown. `cc_backend_simd_flags=-mfma` is appended after the architecture flag and DOES
# escalate the selected ISA -- that is the point of it: on `none` or `-march=x86-64` it turns
# `__FMA__` on -- which is also what makes the emitted kernel's `#elif defined(__FMA__)` arm select
# the FMA3 builtin `__builtin_ia32_vfmaddps`. Use it ONLY where the CPU implements FMA3. Do NOT
# reach for it on an FMA4-only Bulldozer even with `-march=bdver1` still in front: which instruction
# form that combination produces is compiler-dependent and is not settled here -- clang was measured
# to keep the four-operand `vfmaddps`, while gcc is reported to emit three-operand `vfmadd132ps` for
# that same builtin, which such a CPU cannot execute. There it needs no feature flag anyway: the
# architecture flag alone (`-march=native`, `-march=bdver1`) already supplies FMA4. What `-mfma`
# avoids relative to `-march=x86-64-v3`
# is bringing AVX2 and the rest of a broader target along, so it is the narrower escalation, not a
# free one. And `-march=x86-64-v3` brings AVX2, which bdver1 through bdver3 cannot execute --
# Excavator (bdver4) can, having both AVX2 and FMA.
#cc_backend_arch_flags=auto

# Floating-point contraction in the CC backend's compiles, beyond the explicit `fmaf` selections
# the code generator makes: "auto" (the default) passes no flag and leaves the compiler's own
# default, "off" / "on" / "fast" pass `-ffp-contract=<value>`. Whether the compiler is free to
# fuse `a*b+c` into a single rounding differs across compilers and targets, which is why the
# `reproducible` profile pins it off and the `approximate` profile pins it to "fast"; the results
# change either way, so this is a deliberate numerics choice, not an optimization level.
# It is NOT a lever on the no-FMA-target cliff documented at cc_backend_arch_flags: contraction
# decides whether an `a*b+c` the codegen wrote as such may become one rounding, while the calls in
# question are already fused by construction, and on a target without the instruction they stay
# calls under every value here (measured with clang: `-ffp-contract=fast` at `-march=x86-64` leaves
# all of them). cc_backend_fast_math below does move them under clang, but that is compiler-specific
# and a blanket unsafe-math switch besides, not the targeted trade gh-ocannl-719 is about.
#cc_backend_fp_contract=auto

# Explicit SIMD flags appended to the CC backend compiler invocation (gh-ocannl-164).
# The default "auto" probes once per process: if the target selected by cc_backend_arch_flags
# already has AVX2 and FMA, `-mavx2 -mfma -ftree-vectorize` (or the subset the compiler accepts)
# is appended; otherwise (non-AVX2 x86, ARM) nothing is, so generated code never requires an ISA
# beyond the configured target. The value "none" appends nothing at all (whether the probe fires
# is a per-machine fact, so the `reproducible` profile pins this too); like the "none" of
# cc_backend_arch_flags it is spelled as a word because an empty value means "unset". Any other
# value is passed through verbatim.
#cc_backend_simd_flags=auto

# If true (the default), the results of the CC backend's toolchain probes -- the compiler command
# from `ocamlc -config`, cc_backend_simd_flags=auto, cc_parallel_grid=auto -- are memoized in files
# under the temp directory, shared by every OCANNL process on the machine. Probing costs about five
# subprocesses per process, which dominates short runs when many executables run in sequence (a
# `dune build` of the test suite, most visibly on Windows). The memo is keyed by
# cc_backend_compiler_command, cc_backend_arch_flags and PATH, so an opam switch or toolchain change
# re-probes; set to false to probe in-process every time.
#cc_backend_probe_cache=true

# If true, enables `-ffast-math` for the CC backend. This may change numerical behavior, which is
# why the `reproducible` profile pins it off and only the `approximate` profile turns it on.
# UNDER CLANG, on a target with no fused multiply-add instruction, it also changes the CODE SHAPE:
# clang expands the codegen's `fmaf` / `fma` calls into a multiply and an add, which vectorizes
# where the call could not (see the cliff described at cc_backend_arch_flags), at two roundings
# instead of one. This is compiler-specific and NOT a general workaround for that cliff: gcc was
# reported to keep the `fmaf` call at `-O3 -ffast-math` on a baseline x86 target, and gcc is the
# common default here, since cc_backend_compiler_command follows `ocamlc -config`. Where the host
# CPU does have an FMA that a conservative target was hiding, raising the target is the fix to reach
# for instead of this one; where the CPU has no FMA at all, there is no target to raise to and
# changing the arithmetic is the only lever left -- which is what this flag does, at two roundings
# and with everything else `-ffast-math` implies.
#cc_backend_fast_math=false

# If true, compiled dynamic libraries (.dll/.so files) for the CC backend are placed 
# in the build_files directory using the source file path. If false, temporary files
# are used for the dynamic libraries (default behavior).
#output_dlls_in_build_directory=false

# Per-tensor-node cutoff in bytes for considering off-stack allocation, opt-in for backends.
# Decrease it if you see crashes like `bus error`. Values smaller-or-equal 0 mean "no limits".
# Tensors exceeding this size will be allocated on the device's global memory.
#stack_threshold_in_bytes=16384

# Only tensor nodes with up to this many visits per array cell (in a dedicated interpreter)
# can be inlined. Values worth considering: 0 (disables inlining) to 3.
#virtualize_max_visits=1

# Recompute-cost cap for inlining: a tensor node whose computation contains reduction loops
# (loops enclosing a setter without appearing in its indices) with a total trip-count product
# exceeding this value is never virtualized, because inlining would replay the reduction at
# every read site (multiplying through chains of virtual consumers). Negative values disable
# the cap.
#virtualize_max_inline_reduction=16

# Transitive fan-in cap for inlining: a tensor node whose fully-inlined computation would read
# more than this many distinct materialized tensor nodes (accumulated through chains of virtual
# producers, per setter) is materialized instead. This bounds the per-consumer recomputation of
# accumulation chains such as a transformer's residual stream, which the per-node visit and
# reduction caps cannot see: the chain materializes a running sum once per roughly this many
# contributors instead of being re-summed in full at every consumer. Negative values disable
# the cap.
#virtualize_max_inline_fanin=8

# If `true`, tensor nodes will by default not be hosted.
#enable_device_only=true

# If true, scalar constant expressions will always be inlined.
#inline_scalar_constexprs=true

# If true, if the tensor node is built from either single getters, or index embeddings and
# scalar constant expressions, regardless of accesses, it will be inlined.
#inline_simple_computations=true

# If true, virtualize_max_visits only counts accesses that are not used for assignment of
# the same cell (typically accumulation). Otherwise, all accesses are counted, so computations
# that reduce an axis will rarely be inlined.
#inline_complex_computations=true

# Low-level-code identifier syntax. Options: heuristic, name_and_label, name_only.
#ll_ident_style=heuristic

# Computation DSL identifier syntax. Options: heuristic, name_and_label, name_only.
#cd_ident_style=heuristic

# For ppx_minidebug non-flushing static backends, when non-empty, enables snapshotting of ongoing
# logging into a file, with the given frequency.
#snapshot_every_sec=

# Whether ppx_minidebug entries should be tagged by time information.
# Options: not_tagged, clock, elapsed (relative to start of the program).
#time_tagged=elapsed

# Whether ppx_minidebug should print the time span of each entry, and in what units.
# Options: not_reported, seconds, milliseconds, microseconds, nanoseconds.
#elapsed_times=not_reported

# For ppx_minidebug, how file locations should be presented. Options:
# no_location, file_only, beg_line, beg_pos, range_line, range_pos.
#location_format=beg_pos

# The ppx_minidebug logging backend (i.e. format). Options: db, text, html, markdown, flushing.
# The db backend requires a rendering client from ppx_minidebug, the other backends
# generate static (rendered) artifacts.
#debug_backend=db

# For ppx_minidebug: a prefix for file positions relative to the project root.
# A more elaborate example:
# hyperlink_prefix=vscode://file//wsl.localhost/ubuntu-24.04/home/lukstafi/ocannl/
#hyperlink_prefix=./

# For ppx_minidebug: whether to print IDs for log entries.
#logs_print_scope_ids=false

# For ppx_minidebug.
#logs_verbose_scope_ids=false

# For ppx_minidebug, whether logging from the main domain, `Domain.is_main ()`,
# should be directed to stdout rather than to a file.
#log_main_domain_to_stdout=false

# For ppx_minidebug Table of Contents.
#toc_entry_minimal_depth=
#toc_entry_minimal_size=
# The span is expressed in units: ns, us or ms.
#toc_entry_minimal_span=

# For ppx_minidebug: `|`-separated list of terms to highlight in the logs.
#debug_highlights=

# For ppx_minidebug: a pcre syntax regular expression to highlight in the logs.
#debug_highlight_pcre=

# For ppx_minidebug: if provided, enables highlighting differences between the current run
# and a previous run loaded from `.raw` files derived using the given prefix.
#prev_run_prefix=

# For ppx_minidebug: a pcre syntax regular expression pattern that will be removed from messages
# before comparison when highlighting differences between runs, allowing certain differences to be ignored.
#diff_ignore_pattern_pcre=

# If not empty, should be a number giving the depth till which non-highlighted ppx_minidebug
# logs are pruned. Useful when enabling logging (e.g. shape inference) for non-toy examples.
#debug_log_prune_upto=

# For ppx_minidebug: (minimal) width of the search band for the minimal edit distance algorithm.
#diff_max_distance_factor=

# For ppx_minidebug: semicolon-separated list of comma-separated entry IDs from
# the previous and current run, that should be considered the same by the diffing algorithm.
#debug_scope_id_pairs=

# For ppx_minidebug: for generating file names. If empty, all logging will be done to stdout,
# regardless of the value of `log_main_domain_to_stdout`.
#log_file_stem=debug

# For ppx_minidebug: If given a number, sets the `truncate_children` parameter: only this number
# of the most recent children of each log entry are held.`
#debug_log_truncate_children=

# It is useful for testing to have outputs more uniform across backends even if that criples
# some backends. One effect today: logging from routines is spelled to accomodate Metal's
# shortcoming. (It used to also gate the HIP backend's guarded float-to-fp8 conversion; that guard
# is unconditional since gh-ocannl-647, since a twenty-order-of-magnitude error is not a
# uniformity preference.)
#prefer_backend_uniformity=false

# On the CUDA and HIP backends, run a fissioned routine's segment batch by stream-capturing the
# per-segment kernel launches into a graph (cuGraph/hipGraph) and replaying it as one API call
# per step, keyed on the static-index binding values (and merge-buffer position). Removes
# per-launch overhead, which dominates small-model training steps. Automatically bypassed when
# debug_log_from_routines is on, and per-routine if the driver rejects capture. Metal's
# counterpart (fused command-buffer encoding) is always on; the cc backend is unaffected.
#gpu_graph_capture=true

# The initial value for the default precisions for tensors. The default precisions for values and
# gradients can be changed separately via the `Tensor` API.
#default_prec=single

# Numerics policy: allow tensor-core matmuls over uniform-f32 operands to compute in tf32
# (f32's exponent range, 10-bit mantissa, f32 accumulation) on backends with a tf32 tile shape
# (CUDA sm_80+). Off by default because enabling it silently changes numerics (PyTorch-style
# opt-in); the `approximate` profile is the bundled opt-in. Metal (genuine f32 simdgroup tiles)
# and HIP (no tf32-like shape) are unaffected.
# Programmatic override: `Ir.Numerics.set_policy`.
#tf32_matmuls=false

# Numerics policy: on backends without native 16-bit arithmetic (the CPU backends), run the
# arithmetic over narrow-float storage (bfloat16, half, fp8) in f32 -- widen once at each load,
# narrow once at each store -- instead of rounding to the target's storage precision after every
# operator. Storage is unchanged; only the register precision of intermediates is. Reduction
# accumulators are such intermediates (gh-ocannl-639): every rendering of an accumulation nest,
# the unscheduled serial loop included, holds the accumulator in f32 across the whole nest and
# narrows it once at the store, so a narrow-storage reduction's accumulation width does not
# depend on which schedule was chosen. On by default:
# it is strictly more accurate than per-operator rounding, and it is what makes the vectorized
# renderings reachable for narrow-storage kernels. Set to false to recover per-operator rounding
# (per-reduction-step included).
# GPU backends compute narrow arithmetic natively and their pointwise numerics are unaffected
# either way; their reduction-accumulator width follows the tensor-unit formats (gh-ocannl-663):
# serial bf16 reductions on CUDA and fp8 reductions everywhere accumulate in f32 and narrow once
# per nest, mirroring the mma legs, while bf16 on HIP/Metal (whose tiles accumulate in
# storage-width fragments) keeps storage residency; f16 residency is fp16_arithmetic's question,
# not this knob's (gh-ocannl-680). This knob reaches the GPU accumulators only
# where per-step narrowing can be restored SCHEDULE-UNIFORMLY, which is fp8 on CUDA and HIP (no
# backend tensorizes fp8 destinations). It cannot reach bf16 on CUDA — the seeded uniform-bf16
# mma arm accumulates f32 in hardware, so narrowing only the serial legs would make results
# depend on the schedule again; those accumulators stay wide even with the policy off. Nor fp8 on
# Metal, which has no fp8 type at all: every fp8 computation there runs in f32 regardless.
# Programmatic override: `Ir.Numerics.set_policy`.
#narrow_compute_f32=true

# Numerics policy: how f16 computes and accumulates (gh-ocannl-680; ternary since then, and the
# old boolean spellings keep working).
# - "auto" (the default): each backend's structural residency. On the CPU backends f16 computes
#   in f32 (under narrow_compute_f32); on the GPU backends f16 arithmetic is native and reduction
#   accumulators keep storage residency, mirroring the f16-accumulate tensor-unit triple every
#   backend seeds. Currently that means storage-width f16 accumulators on every GPU backend;
#   the auto resolution is per backend and deliberately retains latitude to resolve WIDE on
#   hardware where a wide f16 accumulate costs nothing (datacenter-class NVIDIA), so pin "true"
#   or "false" where that must not move.
# - "false": f16 reduction accumulators reside in f32 on every backend, narrowing once per nest
#   -- the strict cross-backend-uniform semantics. On CUDA sm_80+ the uniform-f16 mma legs stay
#   tensorized through an f32-accumulate inline-PTX arm; on Metal (no mixed-precision
#   simdgroup_multiply_accumulate) and HIP (d-boundary conversion not wired) the uniform-f16 mma
#   seeds are withheld instead -- widening only the serial legs would make results depend on the
#   schedule again (gh-ocannl-663), so this setting trades the f16 tensor-unit legs there.
# - "true": compute fp16 in fp16 on CPU targets with native 16-bit arithmetic (ARMv8.2-FP16,
#   AVX512-FP16) -- the lane count doubles against f32, at fp16's 10-bit mantissa and 65504
#   range for intermediates. Unlike narrow_compute_f32 this trades accuracy for throughput.
#   Ignored on targets whose fp16 arithmetic is promoted to float (see cc_fp16_arithmetic),
#   where it would cost accuracy for no speed; the GPU backends behave as under "auto".
# Programmatic override: `Ir.Numerics.set_policy`.
#fp16_arithmetic=auto

# Whether the cc backend's target has native _Float16 arithmetic. "auto" (the default) probes the
# configured compiler once per process: "none" if _Float16 is missing, "native" if the target
# defines __ARM_FEATURE_FP16_VECTOR_ARITHMETIC or __AVX512FP16__, "promoted" if the type exists
# but the compiler implements its arithmetic by widening to float. Set explicitly to override the
# probe (e.g. to measure the promoted path on a native target).
#cc_fp16_arithmetic=auto

# Limit on the allowed size of unrolled constant tensor nodes
# (where the initialization code sets the values). At most this many elements, a constant
# literal is inlinable: it carries in-kernel initialization code that virtualization can
# dissolve into consumers. Above it, the literal is host-backed data uploaded at link time.
# The threshold only decides inlinability, not where initialization lives: a small constant
# whose placement lands on materialized also drops its in-kernel init in favor of the
# link-time upload (gh-ocannl-633), so schedule legality does not depend on operand literal
# sizes. Setting 0 forces host-side initialization for literals of at least two elements;
# one-element literals always initialize in kernel (the host-backed path would pin their
# element count, breaking broadcast shape inference).
#limit_constant_fill_size=16

# The timeout for the CC backend to wait for the compilation files to appear, in seconds.
# This is the wait after the compiler command exits (doesn't include the compilation time).
#cc_backend_post_compile_timeout=10.0

# If true, the CC backend will fail if the codesign of the compiled dynamic library fails.
#cc_backend_verify_codesign=false

# The maximal number of entries for the provenance of constraints, as for example reported
# in shape error exceptions.
#max_shape_error_origins=20

# Whether Persistence.load / Persistence.restore wrap a checkpoint's payloads as private
# (copy-on-write) memory mappings of the file instead of decoding them into fresh host buffers.
# Only payloads whose file bytes are already their buffer's bytes are mapped; padded tensor nodes
# always take the decoding path, as do payloads whose file offset is not a multiple of their
# element size (which a checkpoint written with a small `alignment` can produce). Defaults to true on every platform. Windows was expected to need
# an exception -- a mapped view keeps the file object referenced, so save's replacing rename over a
# path this process has loaded from should fail with a sharing violation -- but measured on Windows
# 11 (gh-ocannl-588) the rename succeeds and the live mappings go on reading the bytes they were
# taken from, just as a POSIX rename leaves the mapped inode alone. Turn this off if you meet a
# filesystem that does refuse. Per-call override: the `?mmap` argument of `load` / `restore`.
#checkpoint_load_mmap=true

# ---------------------------------------------------------------------------
# The built-in profile payloads
#
# Reproduced from the embedded string constants in `arrayjit/lib/utils.ml` (the
# `test_config_consistency` test fails if the two drift apart). Each line below is a line
# of the payload with a `# ` prefix added, so that copying this file states no settings;
# the payload itself is an ordinary partial `ocannl_config`.

# --- BEGIN PROFILE PAYLOAD reproducible ---
# # Deterministic, and identical across machines wherever reasonable. Cross-BACKEND
# # reproducibility is explicitly out of scope: this profile does not try to make the cc
# # and the cuda backends agree bit for bit.
#
# # The largest cross-machine determinism leak: schedule identity pins numerics (loop order,
# # split reductions, tensorization), so two machines crowning two schedules compute two
# # results. Replaying stays allowed -- a pinned schedule is deterministic -- but only from a
# # CHOSEN autotune_cache_dir: with the search off the built-in default is treated as no cache,
# # so an earlier local search's leftovers in ./autotune_cache cannot silently pin a schedule.
# autotune_search=false
# # The analytic cost model picks schedules from per-backend (and, once calibrated, per-machine)
# # envelope constants -- the same leak without the timing runs.
# model_default_schedule=false
# # The greedy inlining refinement of Train.tune_placements accepts a flip when the timing
# # improves, so which nodes end up inlined is machine-dependent -- and inlining is not
# # numerics-neutral where storage precision is narrower than compute precision: a materialized
# # node rounds to its storage precision, an inlined one does not.
# tune_inline_flips=0
#
# # `-mcpu=native` / `-march=native` changes which FMA and vector instructions the compiler may
# # use, hence the results, per machine. "none" passes no architecture flag.
# cc_backend_arch_flags=none
# # Whether the SIMD probe fires depends on what the toolchain's DEFAULT target already exposes,
# # which is itself a per-machine fact -- so pin the flags off rather than reason about which of
# # them could have changed a result.
# cc_backend_simd_flags=none
# # Contraction the codegen did not ask for (the explicit `fmaf` selections stay): whether a*b+c
# # becomes one fused op is compiler- and target-discretionary.
# cc_backend_fp_contract=off
# cc_backend_fast_math=false
# # Explicit SIMD rendering reassociates strict-FP reductions into per-lane accumulator chains,
# # so the summation order would follow the probed vector width. 0 keeps the serial order.
# cc_vector_bytes=0
#
# # The numerics gates at their exact defaults, so that a profile switch never silently changes
# # what math is being done (they are the orthogonal axis; see the issue). fp16_arithmetic=auto
# # resolves deterministically per backend (gh-ocannl-680), so pinning the default keeps the
# # principle: this profile changes no math, and same-machine runs stay reproducible.
# tf32_matmuls=false
# fp16_arithmetic=auto
# narrow_compute_f32=true
# --- END PROFILE PAYLOAD reproducible ---

# --- BEGIN PROFILE PAYLOAD performance ---
# # The fastest configuration AT UNCHANGED SEMANTICS. Result-changing gates (tf32_matmuls,
# # fp16_arithmetic's accuracy-for-throughput trade is the one exception below, and the
# # algebraic-rewrite tiers) belong to the numerics axis, not to this one.
#
# # Empirical schedule search on, with a wider beam and more rounds than the everyday defaults.
# autotune_search=true
# autotune_beam_width=4
# autotune_rounds=4
# # Untuned compiles still get the cost model's pick instead of the plain default pipeline.
# model_default_schedule=true
#
# # Target the host CPU, and let the SIMD probe add what that target already supports.
# cc_backend_arch_flags=auto
# cc_backend_simd_flags=auto
#
# # Native 16-bit arithmetic where the target has it; ignored on targets that promote fp16 to
# # float, and on the GPU backends (whose f16 arithmetic and accumulators are native narrow
# # under this setting, same as under auto -- gh-ocannl-680).
# fp16_arithmetic=true
# --- END PROFILE PAYLOAD performance ---

# --- BEGIN PROFILE PAYLOAD approximate ---
# # The fastest configuration AT TOLERANCE-BOUNDED SEMANTICS (gh-ocannl-719): the `performance`
# # payload plus every knob that changes numerics for throughput. Results differ from the exact
# # profiles by the tolerance the benchmark parity envelope names (PARITY_TOL_APPROX in
# # benchmarks/orchestrate.py), never in shape or in which operations run. Each key below
# # defaults off for the right reason -- PyTorch-style opt-in -- and this profile is the one
# # word that flips them together, so that a benchmark cell can name the regime in one flag
# # and a report can say which regime a number came from. The policy gates of the algebraic
# # rewrites (online-softmax attention, gh-ocannl-483; Winograd convolution, gh-ocannl-505)
# # join this payload as they land, each in the PR that adds its key.
#
# # The `performance` payload's keys, restated (test_config_consistency checks they agree).
# autotune_search=true
# autotune_beam_width=4
# autotune_rounds=4
# model_default_schedule=true
# cc_backend_arch_flags=auto
# cc_backend_simd_flags=auto
# fp16_arithmetic=true
#
# # f32 matmul operands computed at tf32 (10-bit mantissa, f32 accumulation) on the backends with
# # a tf32 tile shape (CUDA sm_80+); a no-op elsewhere.
# tf32_matmuls=true
# # The C compiler's licence to reassociate (fast-math) and to contract a*b+c into one rounding
# # across statements (fp-contract=fast). Both change results per compiler and target, which is
# # why `reproducible` pins them off and `performance` leaves them at their defaults.
# cc_backend_fast_math=true
# cc_backend_fp_contract=fast
# # The greedy inlining refinement of Train.tune_placements is not numerics-neutral where storage
# # is narrower than compute (a materialized node rounds to its storage precision, an inlined one
# # does not), so `performance` leaves it alone. Two flips: each costs a full search, so this
# # bounds the extra cost at two searches per arm while still exercising the refinement.
# tune_inline_flips=2
# --- END PROFILE PAYLOAD approximate ---
