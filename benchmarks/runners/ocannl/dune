; The runners' JSON scalars and result line, a library rather than a module of the executables so
; that test/operations/bench_result_line can link it without the whole framework (gh-ocannl-676).

(library
 (name bench_json)
 ; Attached to a package (though never installed) because its dependants are: a private library
 ; assigned to a package may not depend on an unpackaged one, and test/operations/bench_result_line
 ; is `(package neural_nets_lib)`.
 (package neural_nets_lib)
 (modules bench_json)
 (libraries base))

; The measurement protocol and everything the runners share, likewise a library rather than a
; module of the executables (gh-ocannl-702): test/operations/bench_self_test drives
; `Bench_harness.run_self_test` — the fixture-free smoke run of `measure_and_emit` — and a module
; of an `(executables)` stanza cannot be linked from a test. Same package, for the same reason as
; bench_json above.

(library
 (name bench_harness)
 (package neural_nets_lib)
 (modules bench_harness)
 (libraries base bench_json ocannl stdio unix mtime mtime.clock.os)
 (preprocess
  (pps ppx_here ppx_ocannl)))

(library
 (name bench_gpt_model)
 (package neural_nets_lib)
 (modules bench_gpt_model)
 (libraries base bench_harness ocannl)
 (preprocess
  (pps ppx_here ppx_ocannl)))

