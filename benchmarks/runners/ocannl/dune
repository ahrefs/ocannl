; The standalone (OCANNL-free) Metal compiler probes: the two accumulation-miscompile
; reproducers, the math-mode reassociation/infinity measurement (gh-ocannl-848), and the
; long-command-buffer queue discriminator (gh-ocannl-828).

(executables
 (names bench_metal_bug bench_metal_bug_local metal_reassoc_probe)
 (modules bench_metal_bug bench_metal_bug_local metal_reassoc_probe)
 (libraries metal ctypes arrayjit.ir arrayjit.metal_math_api_runtime)
 (enabled_if
  (= %{system} macosx))
 (modes exe))

(executable
 (name metal_queue_probe)
 (modules metal_queue_probe)
 (libraries metal ctypes unix)
 (enabled_if
  (= %{system} macosx))
 (modes exe))

; Runtime canary for the queue probe (gh-ocannl-905). `dune build @check` compiles it, which says
; nothing about the Metal calls it makes: a binding change that breaks the library compile, one of
; the three command-buffer submission shapes, or the SharedEvent signal/wait is invisible until
; somebody reruns the probe by hand. `--iterations=N` is the exact-loop-count mode -- no calibration
; -- so the whole path costs a few milliseconds. Nothing here has a timing tolerance to lose on a
; contended runner: the arm comparisons are ratios the probe prints, and only a failed command
; buffer exits nonzero. `--deadline-seconds` supplies the other half of that: every wait in the
; probe is unbounded by design, so a regression that WEDGES a submission would otherwise hold the
; CI job to its own timeout instead of reporting anything.

(rule
 ; ocannl-backend: metal -- the probe drives Metal directly through the `metal` bindings and links
 ; no OCANNL configuration reader, so there is no backend selection in reach to invalidate on.
 (alias bin-smoke)
 (enabled_if
  (= %{system} macosx))
 ; `(universe)` for the reason every command-bearing contribution to this alias has it: a cached
 ; alias action is a canary that ran once.
 (deps (universe))
 (action
  (run %{exe:metal_queue_probe.exe} --iterations=1024 --deadline-seconds=120)))

; The Metal-pinned family (gh-ocannl-783): the rule above names `metal` in its marker, so no other
; box can judge it, and `dune build @metal-codegen` is the entry point a Metal binding change reruns
; without a backend-wide directory run.

(alias
 (name metal-codegen)
 (deps
  (alias bin-smoke)))

; Deep-k CUDA source exporter for the precompiled gh-ocannl-1073 A/B probe.

(executable
 (name bench_mma_register_scope_emit)
 (modules bench_mma_register_scope_emit)
 (libraries base ocannl stdio test_utils ll_test)
 (preprocess
  (pps ppx_here ppx_ocannl))
 (modes exe))

; Opt-in source export: no timing and no GPU execution on @default or @check.

(copy_files ../../ocannl_config)

(rule
 ; ocannl-backend: none -- only checks ambient environment variable spellings.
 (alias mma-register-scope-emit-env_spelling_gate)
 (deps ocannl_config (universe))
 (action
  (run %{exe:../../../bin/env_spelling_gate.exe})))

(rule
 ; ocannl-backend: cuda -- pins the backend in the exporter invocation.
 (alias mma-register-scope-emit)
 ; Keep the opt-in source export in this worktree's build directory after the action.
 (deps
  (sandbox none)
  ocannl_config
  (alias mma-register-scope-emit-env_spelling_gate)
  (env_var OCANNL_BUILD_FILES_PREFIX)
  (env_var OCANNL_BIG_MODELS)
  (env_var OCANNL_CHECK_HALF_PREC_CONSTANTS_CUTOFF)
  (env_var OCANNL_DEBUG_LOG_FROM_ROUTINES)
  (env_var OCANNL_LARGE_MODELS)
  (env_var OCANNL_LOG_LEVEL)
  (env_var OCANNL_PROFILE)
  (env_var OCANNL_SIMPLIFY_FP_ALGEBRA))
 (action
  (no-infer
   (run
    %{exe:bench_mma_register_scope_emit.exe}
    generated-mma-register-scope.cu
    --ocannl_backend=cuda))))
